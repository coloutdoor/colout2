{{define "patio-cover-contractors-woodland-wa.gohtml"}}
  {{template "header.gohtml" .Header}}

  <!-- Hero -->
  <section class="section" style="background: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url('https://storage.googleapis.com/columbiaoutdoor-images/photos-0508.jpg') center/cover no-repeat; padding: 5rem 1.5rem;">
    <div class="container has-text-centered">
      <h1 class="title is-1 has-text-white">Patio Cover Contractors in Woodland, WA</h1>
      <p class="subtitle has-text-white mt-4" style="max-width:700px; margin:1.5rem auto;">
        Stop chasing bids. Start building. Columbia Outdoor delivers
        <strong class="has-text-warning">transparent pricing, quality craftsmanship, and expert project management</strong>
        for patio covers across Woodland and the surrounding Pacific Northwest.
      </p>
      <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;">
        <a href="/contact" class="button is-warning is-large is-rounded mt-4"><strong>Get a Free Estimate</strong></a>
        <a href="/contact" class="button is-light is-large is-rounded mt-4">Talk to a Professional</a>
      </div>
      <p class="has-text-white-ter mt-3 is-size-7">
        Serving Woodland, Kalama, Castle Rock, Ridgefield, La Center, and all of Clark and Cowlitz County, SW Washington.
      </p>
    </div>
  </section>

  <!-- Patio Cover Styles -->
  <section class="section has-background-light">
    <div class="container">
      <h2 class="title is-3 has-text-centered has-text-dark mb-6">Patio Cover Styles We Build</h2>
      <div class="columns">
        <div class="column">
          <div class="box" style="height:100%;">
            <p class="title is-5">Timberframe Covers</p>
            <p class="has-text-grey mb-3">
              Exposed cedar timberframe construction with vaulted or standard trusses — a premium look
              that holds up to SW Washington winters.
            </p>
            <ul>
              <li>Vaulted or standard truss options</li>
              <li>Cedar finish with integrated lighting</li>
              <li>Engineered for local snow and wind loads</li>
            </ul>
          </div>
        </div>
        <div class="column">
          <div class="box" style="height:100%;">
            <p class="title is-5">Aluminum &amp; Lean-To Covers</p>
            <p class="has-text-grey mb-3">
              A lower-maintenance option that still delivers year-round protection for your outdoor living space.
            </p>
            <ul>
              <li>Lean-to and freestanding configurations</li>
              <li>Low-maintenance aluminum construction</li>
              <li>Fast installation timelines</li>
            </ul>
          </div>
        </div>
        <div class="column">
          <div class="box" style="height:100%;">
            <p class="title is-5">Standard Framed Covers</p>
            <p class="has-text-grey mb-3">
              Solid, code-compliant framing built to pass inspection and protect your patio through every season.
            </p>
            <ul>
              <li>Custom sizing to match your patio footprint</li>
              <li>Optional ceiling fans and finished undersides</li>
              <li>Built by licensed, insured local crews</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section">
    <div class="container" style="max-width:780px;">
      <h2 class="title is-3 has-text-centered mb-2">Why Woodland Homeowners Choose Columbia Outdoor</h2>
      <p class="has-text-centered has-text-grey mb-5">
        Columbia Outdoor's experienced team handles your patio cover project from estimate to final walkthrough.
        One point of contact, transparent pricing, and craftsmen who take pride in their work.
      </p>
      <div style="display:flex; flex-direction:column; gap:1rem;">
        <div style="display:flex; align-items:flex-start; gap:1rem;">
          <span class="icon has-text-success mt-1"><i class="fas fa-check-circle fa-lg"></i></span>
          <p class="is-size-5">Licensed, insured, and locally experienced in SW Washington</p>
        </div>
        <div style="display:flex; align-items:flex-start; gap:1rem;">
          <span class="icon has-text-success mt-1"><i class="fas fa-check-circle fa-lg"></i></span>
          <p class="is-size-5">Dedicated project manager as your single point of contact</p>
        </div>
        <div style="display:flex; align-items:flex-start; gap:1rem;">
          <span class="icon has-text-success mt-1"><i class="fas fa-check-circle fa-lg"></i></span>
          <p class="is-size-5">Locked-in pricing with no surprise change orders</p>
        </div>
        <div style="display:flex; align-items:flex-start; gap:1rem;">
          <span class="icon has-text-success mt-1"><i class="fas fa-check-circle fa-lg"></i></span>
          <p class="is-size-5">Permits and inspections handled for you</p>
        </div>
      </div>
      <div class="has-text-centered mt-5">
        <a href="/contact" class="button is-warning is-rounded"><strong>Talk to Us</strong></a>
      </div>
    </div>
  </section>

  <!-- Built for SW Washington -->
  <section class="section has-background-warning-light">
    <div class="container has-text-centered" style="max-width:700px;">
      <h2 class="title is-3">Built for SW Washington</h2>
      <p class="is-size-5">
        SW Washington regulations, permit requirements, and climate demands are our specialty.
        We know Cowlitz County — and what it takes to build a patio cover right the first time.
      </p>
      <p class="mt-3">
        No vague quotes. Our itemized estimates lock in costs upfront. Change orders require
        explicit approval — no surprises.
      </p>
    </div>
  </section>

  <!-- Recent Projects -->
  <section class="section">
    <div class="container">
      <h2 class="title is-3 has-text-centered mb-5">Recent Patio Cover Projects</h2>
      <div class="patio-photo-grid">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0507.jpg" loading="lazy" alt="Standard cover frame">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0508.jpg" loading="lazy" alt="Standard cover with vaulted trusses">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0421.jpg" loading="lazy" alt="Cover engineered trusses">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0510.jpg" loading="lazy" alt="Timberframe finish no hardware">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0509.jpg" loading="lazy" alt="Timberframe beam connection">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0549.jpg" loading="lazy" alt="Woodland basic cover frame — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0475.jpg" loading="lazy" alt="Lean to cover skyjacks">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0060.jpeg" loading="lazy" alt="Lean-to patio cover framing — Vancouver, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0545.jpg" loading="lazy" alt="White cover 2 fans and concrete">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0546.jpg" loading="lazy" alt="White cover finish lean to">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0547.jpg" loading="lazy" alt="White patio cover pergola style">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0450.jpg" loading="lazy" alt="Finish cover standard">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0050.jpg" loading="lazy" alt="Woodland Timberframe king stud and cedar finish — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0049.jpg" loading="lazy" alt="Woodland King stud and struts timberframe — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0053.jpg" loading="lazy" alt="Woodland deck and timberframe — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0015.jpg" loading="lazy" alt="Cathlamet deck and timberframe cover — Cathlamet, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0020.jpg" loading="lazy" alt="Cathlamet roof Timberframe — Cathlamet, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0473.jpg" loading="lazy" alt="Large cover overframe">
      </div>
    </div>
  </section>

  <style>
  .patio-photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }
  .patio-photo-grid img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 6px;
    display: block;
  }
  </style>

  <!-- Final CTA -->
  <section class="section" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://storage.googleapis.com/columbiaoutdoor-images/photos-0510.jpg') center/cover no-repeat; padding: 4rem 1.5rem;">
    <div class="container has-text-centered">
      <h2 class="title is-2 has-text-white">Ready to Talk Patio Covers?</h2>
      <p class="subtitle has-text-white mt-3">
        Get an itemized estimate with no obligation. Our project manager will walk you through
        style options, materials, and timeline for your Woodland patio cover project.
      </p>
      <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;">
        <a href="/contact" class="button is-warning is-large is-rounded mt-4"><strong>Talk to a Professional</strong></a>
        <a href="/deck-calculator?option=deck" class="button is-light is-large is-rounded mt-4">Build Your Own Deck Estimate</a>
      </div>
    </div>
  </section>

  {{template "footer.gohtml" .}}
{{end}}
