{{define "estimate-patio.gohtml"}}
  {{template "header.gohtml" .Header}}

  <link rel="stylesheet" type="text/css" href="/css/estimate.css">

  {{with .Page}}

  {{if .Error}}
  <div class="notification is-danger mb-4"><p>{{.Error}}</p></div>
  {{end}}

  {{/* ── HEADER CARD ── */}}
  <div class="est-header-card">
    <div>
      <p class="est-eyebrow">Columbia Outdoor{{if .Contractor.CompanyName}} &middot; {{.Contractor.CompanyName}}{{end}}</p>
      <h1 class="est-title">
        Patio Cover Estimate{{if gt .EstimateID 0}} #{{.EstimateID}}{{if .Version}}-{{.Version}}{{end}}{{end}}
      </h1>
      <div class="est-project-line">
        {{if .Desc}}
        <span class="est-project">{{.Desc}}</span>
        {{else}}
        <span class="est-project" style="color:var(--est-text3);">No description added</span>
        {{end}}
      </div>
      <div class="est-status-wrap">
        {{if .Status}}
        <span class="est-status-pill {{if eq .Status "Accepted"}}pill-accepted{{else if eq .Status "Expired"}}pill-expired{{else}}pill-pending{{end}}">
          {{if eq .Status "Accepted"}}&#10003; {{end}}{{.Status}}
        </span>
        {{end}}
        {{if and (gt .EstimateID 0) (not .SaveDate.IsZero)}}
          {{if not .AcceptDate.IsZero}}
          <span class="est-date-note">Accepted {{.AcceptDate.Format "Jan 2, 2006"}}</span>
          {{else}}
            {{if not .ExpirationDate.IsZero}}
            <span class="est-date-note">Expires {{.ExpirationDate.Format "Jan 2, 2006"}}</span>
            {{end}}
          {{end}}
        {{end}}
      </div>
      {{if and (gt .EstimateID 0) (not .SaveDate.IsZero)}}
      <p class="est-date-note">Version {{.Version}} &mdash; Saved {{.SaveDate.Format "Jan 2, 2006"}}</p>
      {{end}}
    </div>
    {{if .TotalCost}}
    <div class="est-total-callout">
      <p class="est-total-label">Estimated Total</p>
      <p class="est-total-amount" id="header-total">{{formatCost .TotalCost}}</p>
      <p class="est-total-note">Incl. {{if .Customer.State}}{{.Customer.State}}{{else}}WA{{end}} sales tax</p>
    </div>
    {{end}}
  </div>

  {{/* ── TIER TOGGLE ── */}}
  <div class="est-tier-bar">
    <span class="est-tier-label">Service Tier</span>
    <div class="est-tier-group">
      <button type="button" class="est-tier-btn{{if eq .DIYMode 0}} tier-active-full{{end}}">
        <i class="fas fa-hard-hat"></i> Full Service
      </button>
      <button type="button" class="est-tier-btn{{if eq .DIYMode 1}} tier-active-plans{{end}}">
        <i class="fas fa-tools"></i> Plans + Materials
      </button>
      <button type="button" class="est-tier-btn{{if eq .DIYMode 2}} tier-active-diy{{end}}">
        <i class="fas fa-drafting-compass"></i> Plans Only
      </button>
    </div>
  </div>

  {{/* ── ACTION BAR ── */}}
  <div class="est-action-bar">
    <button id="btn-email" class="est-btn" type="button">
      <i class="fas fa-envelope"></i> Email
    </button>
    <button id="btn-materials" class="est-btn" type="button">
      <i class="fas fa-hammer"></i> Generate Materials
    </button>
    <button id="btn-print" class="est-btn" type="button">
      <i class="fas fa-print"></i> Print
    </button>
  </div>

  {{/* ── PARTY CARDS ── */}}
  <div class="est-parties">
    <div class="est-party-card">
      <p class="est-party-role">From</p>
      {{if .Contractor.CompanyName}}
      <p class="est-party-name">{{.Contractor.CompanyName}}</p>
      <div class="est-party-detail">
        {{if .Contractor.Phone}}<div>{{.Contractor.Phone}}</div>{{end}}
        {{if .Contractor.Website}}<div><a href="{{.Contractor.Website}}" target="_blank">{{.Contractor.Website}}</a></div>{{end}}
        {{if .Contractor.LicenseNum}}<div>License: {{.Contractor.LicenseNum}} ({{.Contractor.LicenseState}})</div>{{end}}
      </div>
      {{else}}
      <p class="est-party-name">Columbia Outdoor</p>
      <div class="est-party-detail">
        <div>(360) 787-8062</div>
        <div>columbiaoutdoor.com</div>
      </div>
      {{end}}
    </div>

    <div class="est-party-card">
      <p class="est-party-role">
        <span>{{if eq $.Header.Role "contractor"}}Customer{{else}}Prepared For{{end}}</span>
        {{if eq .Customer.FirstName ""}}
        <a href="/customer" class="est-party-edit" style="color:var(--est-red); border-color:#f5c6c2;">
          {{if eq $.Header.Role "contractor"}}+ Add Customer{{else}}+ Add Your Info{{end}}
        </a>
        {{else}}
        <a href="/customer" class="est-party-edit">Edit</a>
        {{end}}
      </p>
      {{if or .Customer.FirstName .Customer.LastName}}
      <p class="est-party-name">{{.Customer.FirstName}} {{.Customer.LastName}}</p>
      {{else}}
      <p class="est-party-missing">No customer info added yet</p>
      {{end}}
      <div class="est-party-detail">
        {{if .Customer.Address}}<div>{{.Customer.Address}}</div>{{end}}
        {{if or .Customer.City .Customer.State}}<div>{{.Customer.City}}{{if and .Customer.City .Customer.State}}, {{end}}{{.Customer.State}} {{.Customer.Zip}}</div>{{end}}
        {{if .Customer.PhoneNumber}}<div>{{.Customer.PhoneNumber}}</div>{{end}}
        {{if .Customer.Email}}<div>{{.Customer.Email}}</div>{{end}}
      </div>
    </div>
  </div>

  {{/* ── SCOPE TABLE ── */}}
  <div class="est-scope-card">
    <div class="est-scope-head">
      <span class="est-scope-title">Scope of Work</span>
    </div>
    <div class="est-scope-table-wrap">
    <table class="est-line-items">
      <colgroup>
        <col class="col-item">
        <col class="col-ctl">
        <col>
        <col class="col-cost">
      </colgroup>
      <thead>
        <tr>
          <th>Item</th>
          <th></th>
          <th>Description</th>
          <th class="th-cost">Cost</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="td-item">Patio Cover</td>
          <td class="td-ctl">
            <a href="#" onclick="openPatioModal(); return false;" class="est-edit-btn"><i class="fas fa-pencil-alt"></i></a>
          </td>
          <td class="td-desc" id="patio-desc">{{formatPatioDescription .}}</td>
          <td class="td-cost" id="patio-cost">{{formatCost .BaseCost}}</td>
        </tr>

        {{/* Roof Slope */}}
        <tr>
          <td class="td-item">Roof Slope</td>
          <td class="td-ctl"></td>
          <td class="td-desc" id="roofslope-desc">{{formatPatioRoofSlopeDescription .}}</td>
          <td class="td-cost">{{formatCost 0.0}}</td>
        </tr>

        {{/* Post Wrap */}}
        <tr id="postwrap-row"{{if not .HasPostWrap}} class="zero-row"{{end}}>
          <td class="td-item">Post Wrap</td>
          <td class="td-ctl"><input type="checkbox" class="est-check" {{if .HasPostWrap}}checked{{end}}></td>
          <td class="td-desc" id="postwrap-desc">{{formatPatioPostWrapDescription .}}</td>
          <td class="td-cost" id="postwrap-cost">{{formatCost .PostWrapCost}}</td>
        </tr>

        {{/* Finish Ceiling */}}
        <tr id="finishceiling-row"{{if not .HasFinishCeiling}} class="zero-row"{{end}}>
          <td class="td-item">Finish Ceiling</td>
          <td class="td-ctl"><input type="checkbox" class="est-check" {{if .HasFinishCeiling}}checked{{end}}></td>
          <td class="td-desc" id="finishceiling-desc">{{formatPatioFinishCeilingDescription .}}</td>
          <td class="td-cost" id="finishceiling-cost">{{formatCost .FinishCeilingCost}}</td>
        </tr>

        {{/* Paint or Stain */}}
        <tr id="paintstain-row"{{if not .HasPaintStain}} class="zero-row"{{end}}>
          <td class="td-item">Paint or Stain</td>
          <td class="td-ctl"><input type="checkbox" class="est-check" {{if .HasPaintStain}}checked{{end}}></td>
          <td class="td-desc" id="paintstain-desc">{{formatPatioPaintStainDescription .}}</td>
          <td class="td-cost" id="paintstain-cost">{{formatCost .PaintStainCost}}</td>
        </tr>

        {{/* Finish Hardware */}}
        <tr>
          <td class="td-item">Finish Hardware</td>
          <td class="td-ctl"></td>
          <td class="td-desc" id="finishhardware-desc">{{formatPatioFinishHardwareDescription .}}</td>
          <td class="td-cost" id="finishhardware-cost">{{formatCost .FinishHardwareCost}}</td>
        </tr>

        {{/* Design & Permits */}}
        <tr>
          <td class="td-item">Design &amp; Permits</td>
          <td class="td-ctl"></td>
          <td class="td-desc" id="permit-desc">{{formatPatioPermitDescription .}}</td>
          <td class="td-cost" id="permit-cost">{{formatCost .PermitCost}}</td>
        </tr>
      </tbody>
      <tbody>
        <tr class="est-subtotal-row">
          <td class="td-item">Subtotal</td>
          <td class="td-ctl"></td>
          <td class="td-desc"></td>
          <td class="td-cost" id="subtotal-val">{{formatCost .Subtotal}}</td>
        </tr>
        <tr class="est-tax-row">
          <td class="td-item">Sales Tax</td>
          <td class="td-ctl"></td>
          <td class="td-desc">{{if .Customer.State}}{{.Customer.State}}{{else}}WA{{end}} (estimated)</td>
          <td class="td-cost" id="salestax-val">{{formatCost .SalesTax}}</td>
        </tr>
        <tr class="est-total-row">
          <td class="td-item">Total</td>
          <td class="td-ctl"></td>
          <td class="td-desc">
            {{if not .ExpirationDate.IsZero}}Valid through {{.ExpirationDate.Format "Jan 2, 2006"}}{{end}}
          </td>
          <td class="td-cost" id="total-val">{{formatCost .TotalCost}}</td>
        </tr>
      </tbody>
    </table>
    </div>
  </div>

  <div style="max-width:480px;">
    {{if .Customer.FirstName}}
    <form method="post" action="/patio-estimate">
      <input type="hidden" name="save" value="true">
      <input type="hidden" name="desc" id="save-desc" value="{{.Desc}}">
      <input type="hidden" name="width" id="save-width" value="{{printf "%.1f" .Width}}">
      <input type="hidden" name="length" id="save-depth" value="{{printf "%.1f" .Depth}}">
      <input type="hidden" name="patioType" id="save-patio-type" value="{{.PatioType}}">
      <input type="hidden" name="diyMode" id="save-diy-mode" value="{{.DIYMode}}">
      <button id="btn-save" class="button is-primary is-fullwidth is-medium" type="submit">
        <i class="fas fa-save"></i> {{if .SaveDate.IsZero}}Save Estimate{{else}}Save Changes{{end}}
      </button>
    </form>
    {{else}}
    <div class="notification is-warning is-light">Add your contact info above before saving.</div>
    {{end}}

    {{if or .TermsHTML .Terms}}
    <div class="box mt-5">
      <h3 class="title is-5">Terms and Conditions</h3>
      {{if .TermsHTML}}<div class="content is-small">{{.TermsHTML}}</div>{{else}}<pre class="is-size-7">{{.Terms}}</pre>{{end}}
    </div>
    {{end}}
  </div>

  {{/* ── EDIT MODAL ── */}}
  <div id="patio-modal" class="modal">
    <div class="modal-background" onclick="document.getElementById('patio-modal').classList.remove('is-active')"></div>
    <div class="modal-card" style="max-width:420px;">
      <header class="modal-card-head">
        <p class="modal-card-title">Patio Cover Size &amp; Type</p>
        <button class="delete" aria-label="close" onclick="document.getElementById('patio-modal').classList.remove('is-active')"></button>
      </header>
      <section class="modal-card-body">
        <div class="field">
          <label class="label">Width (ft)</label>
          <div class="control">
            <input id="patio-width" class="input" type="number" step="0.1" min="1" placeholder="e.g. 20">
          </div>
        </div>
        <div class="field">
          <label class="label">Depth (ft)</label>
          <div class="control">
            <input id="patio-depth" class="input" type="number" step="0.1" min="1" placeholder="e.g. 14">
          </div>
        </div>
        <div class="field">
          <label class="label">Patio Type</label>
          <div class="control">
            <div class="select is-fullwidth">
              <select id="patio-type-select">
                <option value="pergola">Pergola</option>
                <option value="leanto">Lean-to</option>
                <option value="truss">Truss</option>
                <option value="timberframe">Timberframe</option>
              </select>
            </div>
          </div>
        </div>
      </section>
      <footer class="modal-card-foot">
        <button class="button is-primary" onclick="applyPatio()">Apply</button>
        <button class="button" onclick="document.getElementById('patio-modal').classList.remove('is-active')">Cancel</button>
      </footer>
    </div>
  </div>

  <script>
    const estimateData = {
      width:            {{.Width}},
      depth:            {{.Depth}},
      patioType:        {{.PatioType | jsStr}},
      diyMode:          {{.DIYMode}},
      customerState:    {{if .Customer.State}}{{.Customer.State | jsStr}}{{else}}"WA"{{end}},
      hasPostWrap:      {{.HasPostWrap}},
      hasFinishCeiling: {{.HasFinishCeiling}},
      hasPaintStain:    {{.HasPaintStain}},
      permitLevel:      {{.PermitLevel}},
    };

    function formatCost(n) {
      return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function openPatioModal() {
      document.getElementById('patio-width').value = estimateData.width;
      document.getElementById('patio-depth').value = estimateData.depth;
      document.getElementById('patio-type-select').value = estimateData.patioType;
      document.getElementById('patio-modal').classList.add('is-active');
    }

    function applyPatio() {
      const width = parseFloat(document.getElementById('patio-width').value);
      const depth = parseFloat(document.getElementById('patio-depth').value);
      if (isNaN(width) || width < 1) { alert('Please enter a valid width (1 ft or more)'); return; }
      if (isNaN(depth) || depth < 1) { alert('Please enter a valid depth (1 ft or more)'); return; }
      estimateData.width = width;
      estimateData.depth = depth;
      estimateData.patioType = document.getElementById('patio-type-select').value;
      document.getElementById('patio-modal').classList.remove('is-active');
      calcAndUpdate();
    }

    function calcAndUpdate() {
      document.getElementById('save-width').value = estimateData.width;
      document.getElementById('save-depth').value = estimateData.depth;
      document.getElementById('save-patio-type').value = estimateData.patioType;

      const unsaved = document.getElementById('unsaved-msg');
      if (unsaved) unsaved.style.display = '';

      fetch('/api/calc/patio', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(estimateData),
      })
      .then(r => r.json())
      .then(data => {
        if (data.error) { console.error('Calc error:', data.error); return; }
        document.getElementById('patio-desc').textContent = data.patioDescription;
        document.getElementById('patio-cost').textContent = formatCost(data.baseCost);
        document.getElementById('roofslope-desc').textContent = data.roofSlopeDescription;
        document.getElementById('postwrap-desc').textContent = data.postWrapDescription;
        document.getElementById('finishceiling-desc').textContent = data.finishCeilingDescription;
        document.getElementById('paintstain-desc').textContent = data.paintStainDescription;
        document.getElementById('finishhardware-desc').textContent = data.finishHardwareDescription;
        document.getElementById('permit-desc').textContent = data.permitDescription;
        document.getElementById('permit-cost').textContent = formatCost(data.permitCost);
        document.getElementById('subtotal-val').textContent = formatCost(data.subtotal);
        document.getElementById('salestax-val').textContent = formatCost(data.salesTax);
        document.getElementById('total-val').textContent = formatCost(data.totalCost);
        const headerTotal = document.getElementById('header-total');
        if (headerTotal) headerTotal.textContent = formatCost(data.totalCost);
      })
      .catch(err => console.error('API error:', err));
    }
  </script>
  {{end}}

  {{template "footer.gohtml" .}}
{{end}}
