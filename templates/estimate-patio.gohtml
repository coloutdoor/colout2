{{define "estimate-patio.gohtml"}}
  {{template "header.gohtml" .Header}}

  <link rel="stylesheet" type="text/css" href="/css/estimate.css">

  {{with .Page}}

  {{if .Error}}
  <div class="notification is-danger mb-4"><p>{{.Error}}</p></div>
  {{end}}

  {{/* ── HEADER CARD ── */}}
  <div class="est-header-card">
    <div>
      <p class="est-eyebrow">Columbia Outdoor{{if .Contractor.CompanyName}} &middot; {{.Contractor.CompanyName}}{{end}}</p>
      <h1 class="est-title">
        Patio Cover Estimate{{if gt .EstimateID 0}} #{{.EstimateID}}{{if .Version}}-{{.Version}}{{end}}{{end}}
      </h1>
      <div class="est-project-line">
        {{if .Desc}}
        <span class="est-project">{{.Desc}}</span>
        {{else}}
        <span class="est-project" style="color:var(--est-text3);">No description added</span>
        {{end}}
      </div>
      <div class="est-status-wrap">
        {{if .Status}}
        <span class="est-status-pill {{if eq .Status "Accepted"}}pill-accepted{{else if eq .Status "Expired"}}pill-expired{{else}}pill-pending{{end}}">
          {{if eq .Status "Accepted"}}&#10003; {{end}}{{.Status}}
        </span>
        {{end}}
        {{if and (gt .EstimateID 0) (not .SaveDate.IsZero)}}
          {{if not .AcceptDate.IsZero}}
          <span class="est-date-note">Accepted {{.AcceptDate.Format "Jan 2, 2006"}}</span>
          {{else}}
            {{if not .ExpirationDate.IsZero}}
            <span class="est-date-note">Expires {{.ExpirationDate.Format "Jan 2, 2006"}}</span>
            {{end}}
          {{end}}
        {{end}}
      </div>
      {{if and (gt .EstimateID 0) (not .SaveDate.IsZero)}}
      <p class="est-date-note">Version {{.Version}} &mdash; Saved {{.SaveDate.Format "Jan 2, 2006"}}</p>
      {{end}}
    </div>
    {{if .TotalCost}}
    <div class="est-total-callout">
      <p class="est-total-label">Estimated Total</p>
      <p class="est-total-amount" id="header-total">{{formatCost .TotalCost}}</p>
      <p class="est-total-note">Incl. {{if .Customer.State}}{{.Customer.State}}{{else}}WA{{end}} sales tax</p>
    </div>
    {{end}}
  </div>

  {{/* ── TIER TOGGLE ── */}}
  <div class="est-tier-bar">
    <span class="est-tier-label">Service Tier</span>
    <div class="est-tier-group">
      <button type="button" class="est-tier-btn{{if eq .DIYMode 0}} tier-active-full{{end}}">
        <i class="fas fa-hard-hat"></i> Full Service
      </button>
      <button type="button" class="est-tier-btn{{if eq .DIYMode 1}} tier-active-plans{{end}}">
        <i class="fas fa-tools"></i> Plans + Materials
      </button>
      <button type="button" class="est-tier-btn{{if eq .DIYMode 2}} tier-active-diy{{end}}">
        <i class="fas fa-drafting-compass"></i> Plans Only
      </button>
    </div>
  </div>

  {{/* ── ACTION BAR ── */}}
  <div class="est-action-bar">
    {{if and (not .SaveDate.IsZero) (not .IsPublicView)}}
    <button id="btn-email" class="est-btn" type="button"
      onclick="document.getElementById('email-modal').classList.add('is-active')">
      <i class="fas fa-envelope"></i> Email
    </button>
    {{end}}
    {{if and (not .SaveDate.IsZero) (not .IsPublicView) (or $.Header.IsAdmin (eq $.Header.Role "contractor"))}}
    <button id="btn-materials" class="est-btn" type="button">
      <i class="fas fa-hammer"></i> Generate Materials
    </button>
    {{end}}
    {{if and (not .SaveDate.IsZero) (not .IsPublicView)}}
    <button id="btn-print" class="est-btn" type="button">
      <i class="fas fa-print"></i> Print
    </button>
    {{end}}
    {{if and (not .SaveDate.IsZero) .AcceptDate.IsZero}}
      {{if or (eq $.Header.Role "homeowner") .IsPublicView}}
      <button id="btn-accept" class="est-btn est-btn-success" type="button"
        onclick="document.getElementById('accept-confirm').classList.add('is-active')">
        <i class="fas fa-check"></i> Accept Estimate
      </button>
      {{end}}
    {{end}}
  </div>

  {{/* ── PARTY CARDS ── */}}
  <div class="est-parties">
    <div class="est-party-card">
      <p class="est-party-role">From</p>
      {{if .Contractor.CompanyName}}
      <p class="est-party-name">{{.Contractor.CompanyName}}</p>
      <div class="est-party-detail">
        {{if .Contractor.Phone}}<div>{{.Contractor.Phone}}</div>{{end}}
        {{if .Contractor.Website}}<div><a href="{{.Contractor.Website}}" target="_blank">{{.Contractor.Website}}</a></div>{{end}}
        {{if .Contractor.LicenseNum}}<div>License: {{.Contractor.LicenseNum}} ({{.Contractor.LicenseState}})</div>{{end}}
      </div>
      {{else}}
      <p class="est-party-name">Columbia Outdoor</p>
      <div class="est-party-detail">
        <div>(360) 787-8062</div>
        <div>columbiaoutdoor.com</div>
      </div>
      {{end}}
    </div>

    <div class="est-party-card">
      <p class="est-party-role">
        <span>{{if eq $.Header.Role "contractor"}}Customer{{else}}Prepared For{{end}}</span>
        {{if eq .Customer.FirstName ""}}
        <a href="/customer" class="est-party-edit" style="color:var(--est-red); border-color:#f5c6c2;">
          {{if eq $.Header.Role "contractor"}}+ Add Customer{{else}}+ Add Your Info{{end}}
        </a>
        {{else}}
        <a href="/customer" class="est-party-edit">Edit</a>
        {{end}}
      </p>
      {{if or .Customer.FirstName .Customer.LastName}}
      <p class="est-party-name">{{.Customer.FirstName}} {{.Customer.LastName}}</p>
      {{else}}
      <p class="est-party-missing">No customer info added yet</p>
      {{end}}
      <div class="est-party-detail">
        {{if .Customer.Address}}<div>{{.Customer.Address}}</div>{{end}}
        {{if or .Customer.City .Customer.State}}<div>{{.Customer.City}}{{if and .Customer.City .Customer.State}}, {{end}}{{.Customer.State}} {{.Customer.Zip}}</div>{{end}}
        {{if .Customer.PhoneNumber}}<div>{{.Customer.PhoneNumber}}</div>{{end}}
        {{if .Customer.Email}}<div>{{.Customer.Email}}</div>{{end}}
      </div>
    </div>
  </div>

  {{/* ── SCOPE TABLE ── */}}
  <div class="est-scope-card">
    <div class="est-scope-head">
      <span class="est-scope-title">Scope of Work</span>
    </div>
    <div class="est-scope-table-wrap">
    <table class="est-line-items">
      <colgroup>
        <col class="col-item">
        <col class="col-ctl">
        <col>
        <col class="col-cost">
      </colgroup>
      <thead>
        <tr>
          <th>Item</th>
          <th></th>
          <th>Description</th>
          <th class="th-cost">Cost</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="td-item">Patio Cover</td>
          <td class="td-ctl">
            {{if not .IsPublicView}}<a href="#" onclick="openPatioModal(); return false;" class="est-edit-btn"><i class="fas fa-pencil-alt"></i></a>{{end}}
          </td>
          <td class="td-desc" id="patio-desc">{{formatPatioDescription .}}</td>
          <td class="td-cost" id="patio-cost">{{formatCost .BaseCost}}</td>
        </tr>

        {{/* Roof Slope */}}
        <tr>
          <td class="td-item">Roof Slope</td>
          <td class="td-ctl">
            {{if not .IsPublicView}}
            <a id="roofslope-editbtn" href="#" onclick="openRoofSlopeModal(); return false;" class="est-edit-btn"
              style="{{if not (or (eq .PatioType "truss") (eq .PatioType "timberframe"))}}display:none;{{end}}">
              <i class="fas fa-pencil-alt"></i>
            </a>
            {{end}}
          </td>
          <td class="td-desc" id="roofslope-desc">{{formatPatioRoofSlopeDescription .}}</td>
          <td class="td-cost" id="roofslope-cost">{{formatCost .RoofSlopeCost}}</td>
        </tr>

        {{/* Post Wrap */}}
        <tr id="postwrap-row"{{if not .HasPostWrap}} class="zero-row"{{end}}>
          <td class="td-item">Post Wrap</td>
          <td class="td-ctl">{{if not .IsPublicView}}<input id="postwrap-check" type="checkbox" class="est-check" {{if .HasPostWrap}}checked{{end}} onchange="toggleHasPostWrap(this.checked)">{{end}}</td>
          <td class="td-desc" id="postwrap-desc">{{formatPatioPostWrapDescription .}}</td>
          <td class="td-cost" id="postwrap-cost">{{formatCost .PostWrapCost}}</td>
        </tr>

        {{/* Finish Ceiling */}}
        <tr id="finishceiling-row"{{if or (eq .PatioType "pergola") (and (ne .PatioType "timberframe") (not .HasFinishCeiling))}} class="zero-row"{{end}}>
          <td class="td-item">Finish Ceiling</td>
          <td class="td-ctl">
            {{if not .IsPublicView}}
            <input id="finishceiling-check" type="checkbox" class="est-check" {{if .HasFinishCeiling}}checked{{end}}
              style="{{if or (eq .PatioType "pergola") (eq .PatioType "timberframe")}}display:none;{{end}}"
              onchange="toggleHasFinishCeiling(this.checked)">
            {{end}}
          </td>
          <td class="td-desc" id="finishceiling-desc">{{formatPatioFinishCeilingDescription .}}</td>
          <td class="td-cost" id="finishceiling-cost">{{formatCost .FinishCeilingCost}}</td>
        </tr>

        {{/* Paint or Stain */}}
        <tr id="paintstain-row"{{if not .HasPaintStain}} class="zero-row"{{end}}>
          <td class="td-item">Paint or Stain</td>
          <td class="td-ctl">{{if not .IsPublicView}}<input id="paintstain-check" type="checkbox" class="est-check" {{if .HasPaintStain}}checked{{end}} onchange="toggleHasPaintStain(this.checked)">{{end}}</td>
          <td class="td-desc" id="paintstain-desc">{{formatPatioPaintStainDescription .}}</td>
          <td class="td-cost" id="paintstain-cost">{{formatCost .PaintStainCost}}</td>
        </tr>

        {{/* Finish Hardware */}}
        <tr id="finishhardware-row"{{if not .HasFinishHardware}} class="zero-row"{{end}}>
          <td class="td-item">Finish Hardware</td>
          <td class="td-ctl">{{if not .IsPublicView}}<input id="finishhardware-check" type="checkbox" class="est-check" {{if .HasFinishHardware}}checked{{end}} onchange="toggleHasFinishHardware(this.checked)">{{end}}</td>
          <td class="td-desc" id="finishhardware-desc">{{formatPatioFinishHardwareDescription .}}</td>
          <td class="td-cost" id="finishhardware-cost">{{formatCost .FinishHardwareCost}}</td>
        </tr>

        {{/* Electrical */}}
        <tr id="electrical-row"{{if not .HasElectrical}} class="zero-row"{{end}}>
          <td class="td-item">Electrical</td>
          <td class="td-ctl">
            {{if not .IsPublicView}}<a href="#" onclick="openElectricalModal(); return false;" class="est-edit-btn"><i class="fas fa-pencil-alt"></i></a>{{end}}
          </td>
          <td class="td-desc" id="electrical-desc">{{formatPatioElectricalDescription .}}</td>
          <td class="td-cost" id="electrical-cost">{{formatCost .ElectricalCost}}</td>
        </tr>

        {{/* Design & Permits */}}
        <tr>
          <td class="td-item">Design &amp; Permits</td>
          <td class="td-ctl">
            {{if not .IsPublicView}}<a href="#" onclick="openPermitModal(); return false;" class="est-edit-btn"><i class="fas fa-pencil-alt"></i></a>{{end}}
          </td>
          <td class="td-desc" id="permit-desc">{{formatPatioPermitDescription .}}</td>
          <td class="td-cost" id="permit-cost">{{formatCost .PermitCost}}</td>
        </tr>

        {{/* Custom line items */}}
      </tbody>
      <tbody id="custom-items-rows"></tbody>
      <tbody>
        {{if and (not .IsPublicView) (or (eq $.Header.Role "contractor") $.Header.IsAdmin)}}
        <tr class="est-add-custom-row">
          <td colspan="4">
            <button type="button" class="est-add-custom-btn" onclick="openCustomItemModal()">
              <i class="fas fa-plus"></i> Add Custom Line
            </button>
          </td>
        </tr>
        {{end}}

        {{/* Subtotal */}}
        <tr class="est-subtotal-row">
          <td class="td-item">Subtotal</td>
          <td class="td-ctl"></td>
          <td class="td-desc"></td>
          <td class="td-cost" id="subtotal-val">{{formatCost .Subtotal}}</td>
        </tr>

        {{/* Promo code */}}
        {{if not .IsPublicView}}
        <tr class="est-promo-row">
          <td class="td-item" style="color:var(--est-text2); font-weight:400; font-size:.8rem;">Promo Code</td>
          <td class="td-ctl"></td>
          <td class="td-desc">
            <div class="est-promo-wrap">
              <input class="est-promo-input" type="text" id="discount-code-input" placeholder="Enter promo code"
                value="{{.DiscountCode}}"
                onkeydown="if(event.key==='Enter'){applyDiscountCode();event.preventDefault();}">
              <button class="est-promo-btn" type="button" onclick="applyDiscountCode()">Apply</button>
            </div>
            <p id="discount-msg" class="help"></p>
          </td>
          <td class="td-cost"></td>
        </tr>
        {{end}}

        {{/* Discount row */}}
        <tr id="discount-row-label" class="est-discount-row" {{if eq .DiscountAmount 0.0}}style="display:none;"{{end}}>
          <td class="td-item">Discount</td>
          <td class="td-ctl"></td>
          <td class="td-desc" id="discount-desc">{{if .DiscountCode}}{{.DiscountCode}} — 10% off{{end}}</td>
          <td class="td-cost" id="discount-val">{{if gt .DiscountAmount 0.0}}-{{formatCost .DiscountAmount}}{{end}}</td>
        </tr>

        <tr class="est-tax-row">
          <td class="td-item">Sales Tax</td>
          <td class="td-ctl"></td>
          <td class="td-desc">{{if .Customer.State}}{{.Customer.State}}{{else}}WA{{end}} (estimated)</td>
          <td class="td-cost" id="salestax-val">{{formatCost .SalesTax}}</td>
        </tr>
        <tr class="est-total-row">
          <td class="td-item">Total</td>
          <td class="td-ctl"></td>
          <td class="td-desc">
            {{if not .ExpirationDate.IsZero}}Valid through {{.ExpirationDate.Format "Jan 2, 2006"}}{{end}}
          </td>
          <td class="td-cost" id="total-val">{{formatCost .TotalCost}}</td>
        </tr>
      </tbody>
    </table>
    </div>
  </div>

  <div style="max-width:480px;">
    {{if not .IsPublicView}}
    {{if .Customer.FirstName}}
    <form method="post" action="/patio-estimate">
      <input type="hidden" name="save" value="true">
      <input type="hidden" name="desc" id="save-desc" value="{{.Desc}}">
      <input type="hidden" name="width" id="save-width" value="{{printf "%.1f" .Width}}">
      <input type="hidden" name="length" id="save-depth" value="{{printf "%.1f" .Depth}}">
      <input type="hidden" name="patioType" id="save-patio-type" value="{{.PatioType}}">
      <input type="hidden" name="roofSlope" id="save-roof-slope" value="{{.RoofSlope}}">
      <input type="hidden" name="hasPostWrap" id="save-has-post-wrap" value="{{if .HasPostWrap}}true{{else}}false{{end}}">
      <input type="hidden" name="hasFinishCeiling" id="save-has-finish-ceiling" value="{{if .HasFinishCeiling}}true{{else}}false{{end}}">
      <input type="hidden" name="hasPaintStain" id="save-has-paint-stain" value="{{if .HasPaintStain}}true{{else}}false{{end}}">
      <input type="hidden" name="hasFinishHardware" id="save-has-finish-hardware" value="{{if .HasFinishHardware}}true{{else}}false{{end}}">
      <input type="hidden" name="electricalLights" id="save-electrical-lights" value="{{.ElectricalLights}}">
      <input type="hidden" name="electricalFans" id="save-electrical-fans" value="{{.ElectricalFans}}">
      <input type="hidden" name="electricalSwitches" id="save-electrical-switches" value="{{.ElectricalSwitches}}">
      <input type="hidden" name="electricalOutlets" id="save-electrical-outlets" value="{{.ElectricalOutlets}}">
      <input type="hidden" name="permitLevel" id="save-permit-level" value="{{.PermitLevel}}">
      <input type="hidden" name="diyMode" id="save-diy-mode" value="{{.DIYMode}}">
      <input type="hidden" name="discountCode" id="save-discount-code" value="{{.DiscountCode}}">
      <input type="hidden" name="customItems" id="save-custom-items" value="">
      <button id="btn-save" class="button is-primary is-fullwidth is-medium" type="submit">
        <i class="fas fa-save"></i> {{if .SaveDate.IsZero}}Save Estimate{{else}}Save Changes{{end}}
      </button>
    </form>
    {{else}}
    <div class="notification is-warning is-light">Add your contact info above before saving.</div>
    {{end}}
    {{end}}
  </div>

  {{if and (not .SaveDate.IsZero) (or .TermsHTML .Terms)}}
  <div class="content mt-4">
    <h2 class="subtitle">Terms and Conditions</h2>
    {{if .TermsHTML}}
    <div class="content is-small">{{.TermsHTML}}</div>
    {{else}}
    <pre class="is-size-7">{{.Terms}}</pre>
    {{end}}
  </div>
  {{end}}

  {{/* ── EDIT MODAL ── */}}
  <div id="patio-modal" class="modal">
    <div class="modal-background" onclick="document.getElementById('patio-modal').classList.remove('is-active')"></div>
    <div class="modal-card" style="max-width:420px;">
      <header class="modal-card-head">
        <p class="modal-card-title">Patio Cover Size &amp; Type</p>
        <button class="delete" aria-label="close" onclick="document.getElementById('patio-modal').classList.remove('is-active')"></button>
      </header>
      <section class="modal-card-body">
        <div class="field">
          <label class="label">Width (ft)</label>
          <div class="control">
            <input id="patio-width" class="input" type="number" step="0.1" min="1" placeholder="e.g. 20">
          </div>
        </div>
        <div class="field">
          <label class="label">Depth (ft)</label>
          <div class="control">
            <input id="patio-depth" class="input" type="number" step="0.1" min="1" placeholder="e.g. 14">
          </div>
        </div>
        <div class="field">
          <label class="label">Patio Type</label>
          <div class="control">
            <div class="select is-fullwidth">
              <select id="patio-type-select">
                <option value="pergola">Pergola</option>
                <option value="leanto">Lean-to</option>
                <option value="truss">Truss</option>
                <option value="timberframe">Timberframe</option>
              </select>
            </div>
          </div>
        </div>
      </section>
      <footer class="modal-card-foot">
        <button class="button is-primary" onclick="applyPatio()">Apply</button>
        <button class="button" onclick="document.getElementById('patio-modal').classList.remove('is-active')">Cancel</button>
      </footer>
    </div>
  </div>

  <div id="roofslope-modal" class="modal">
    <div class="modal-background" onclick="document.getElementById('roofslope-modal').classList.remove('is-active')"></div>
    <div class="modal-card" style="max-width:360px;">
      <header class="modal-card-head">
        <p class="modal-card-title">Roof Slope</p>
        <button class="delete" aria-label="close" onclick="document.getElementById('roofslope-modal').classList.remove('is-active')"></button>
      </header>
      <section class="modal-card-body">
        <div class="field">
          <label class="label">Slope (rise per 12" run)</label>
          <div class="control">
            <input id="roofslope-input" class="input" type="number" step="1" min="4" placeholder="e.g. 4">
          </div>
          <p class="help">4:12 is the baseline, included in the base price. Each additional 1:12 adds cost based on total roof area.</p>
        </div>
      </section>
      <footer class="modal-card-foot">
        <button class="button is-primary" onclick="applyRoofSlope()">Apply</button>
        <button class="button" onclick="document.getElementById('roofslope-modal').classList.remove('is-active')">Cancel</button>
      </footer>
    </div>
  </div>

  <div id="electrical-modal" class="modal">
    <div class="modal-background" onclick="document.getElementById('electrical-modal').classList.remove('is-active')"></div>
    <div class="modal-card" style="max-width:420px;">
      <header class="modal-card-head">
        <p class="modal-card-title">Electrical</p>
        <button class="delete" aria-label="close" onclick="document.getElementById('electrical-modal').classList.remove('is-active')"></button>
      </header>
      <section class="modal-card-body">
        <div class="field">
          <label class="label">Canned Lights (0-10)</label>
          <div class="control">
            <div class="select is-fullwidth">
              <select id="electrical-lights-select">
                <option value="0">0</option><option value="1">1</option><option value="2">2</option>
                <option value="3">3</option><option value="4">4</option><option value="5">5</option>
                <option value="6">6</option><option value="7">7</option><option value="8">8</option>
                <option value="9">9</option><option value="10">10</option>
              </select>
            </div>
          </div>
        </div>
        <div class="field">
          <label class="label">Ceiling Fans (0-3)</label>
          <div class="control">
            <div class="select is-fullwidth">
              <select id="electrical-fans-select">
                <option value="0">0</option><option value="1">1</option>
                <option value="2">2</option><option value="3">3</option>
              </select>
            </div>
          </div>
        </div>
        <div class="field">
          <label class="label">Switches (0-3)</label>
          <div class="control">
            <div class="select is-fullwidth">
              <select id="electrical-switches-select">
                <option value="0">0</option><option value="1">1</option>
                <option value="2">2</option><option value="3">3</option>
              </select>
            </div>
          </div>
        </div>
        <div class="field">
          <label class="label">Outlets (0-4)</label>
          <div class="control">
            <div class="select is-fullwidth">
              <select id="electrical-outlets-select">
                <option value="0">0</option><option value="1">1</option><option value="2">2</option>
                <option value="3">3</option><option value="4">4</option>
              </select>
            </div>
          </div>
        </div>
        <p class="help mt-3">$1,500 base plus $175 per item once any item is selected. Includes electrical permits and installation by a licensed electrician. Additional costs may be needed for any changes to the main circuit including lines, breakers, or upgrades.</p>
      </section>
      <footer class="modal-card-foot">
        <button class="button is-primary" onclick="applyElectrical()">Apply</button>
        <button class="button" onclick="document.getElementById('electrical-modal').classList.remove('is-active')">Cancel</button>
      </footer>
    </div>
  </div>

  <div id="permit-modal" class="modal">
    <div class="modal-background" onclick="document.getElementById('permit-modal').classList.remove('is-active')"></div>
    <div class="modal-card" style="max-width:400px;">
      <header class="modal-card-head">
        <p class="modal-card-title">Design &amp; Permits</p>
        <button class="delete" aria-label="close" onclick="document.getElementById('permit-modal').classList.remove('is-active')"></button>
      </header>
      <section class="modal-card-body">
        <div class="field">
          <label class="label">Select services to include</label>
          <div class="control">
            <div class="select is-fullwidth">
              <select id="permit-level-select">
                <option value="0">Material Takeoff</option>
                <option value="1">Design</option>
                <option value="2">Design + Engineering</option>
                <option value="3">Design + Engineering + Permits</option>
              </select>
            </div>
          </div>
        </div>
        <p class="help mt-3">Design and engineering may be required by your local jurisdiction depending on cover height and size.</p>
      </section>
      <footer class="modal-card-foot">
        <button class="button is-primary" onclick="applyPermit()">Apply</button>
        <button class="button" onclick="document.getElementById('permit-modal').classList.remove('is-active')">Cancel</button>
      </footer>
    </div>
  </div>

  <div id="custom-item-modal" class="modal">
    <div class="modal-background" onclick="closeCustomItemModal()"></div>
    <div class="modal-card" style="max-width:420px;">
      <header class="modal-card-head">
        <p class="modal-card-title">Custom Line Item</p>
        <button class="delete" aria-label="close" onclick="closeCustomItemModal()"></button>
      </header>
      <section class="modal-card-body">
        <div class="field">
          <label class="label">Item</label>
          <div class="control">
            <input id="ci-item" class="input" type="text" placeholder="e.g. Concrete landing"
              onkeydown="if(event.key==='Enter'){document.getElementById('ci-notes').focus();}">
          </div>
        </div>
        <div class="field">
          <label class="label">Description <span class="has-text-grey is-size-7 has-text-weight-normal">(optional)</span></label>
          <div class="control">
            <input id="ci-notes" class="input" type="text" placeholder="Additional details"
              onkeydown="if(event.key==='Enter'){document.getElementById('ci-cost').focus();}">
          </div>
        </div>
        <div class="field">
          <label class="label">Cost</label>
          <div class="field has-addons mb-1">
            <p class="control"><span class="button is-static">$</span></p>
            <p class="control is-expanded">
              <input id="ci-cost" class="input" type="number" step="0.01" placeholder="0.00"
                onkeydown="if(event.key==='Enter'){applyCustomItem();}">
            </p>
          </div>
          <p class="help has-text-grey">Enter a negative amount to apply a credit or discount.</p>
        </div>
      </section>
      <footer class="modal-card-foot">
        <button class="button is-primary" onclick="applyCustomItem()">Apply</button>
        <button class="button" onclick="closeCustomItemModal()">Cancel</button>
      </footer>
    </div>
  </div>

  {{if gt .EstimateID 0}}
  <div id="email-modal" class="modal">
    <input type="hidden" id="estimate-id" value="{{ .EstimateID }}">
    <div class="modal-background" onclick="document.getElementById('email-modal').classList.remove('is-active')"></div>
    <div class="modal-card">
      <header class="modal-card-head">
        <p class="modal-card-title">Send Estimate via Email</p>
        <button class="delete" aria-label="close" onclick="document.getElementById('email-modal').classList.remove('is-active')"></button>
      </header>
      <section class="modal-card-body">
        <div class="field">
          <label class="label">Send estimate to:</label>
          <div class="control">
            <input class="input" type="email" id="email-input" value="{{ .Customer.Email }}" placeholder="customer@example.com">
          </div>
        </div>
        {{if $.Header.IsAuthenticated}}
        <div class="field">
          <label class="checkbox">
            <input type="checkbox" id="cc-self-check">
            Also send a copy to me ({{$.Header.Email}})
          </label>
        </div>
        {{end}}
      </section>
      <footer class="modal-card-foot">
        <button class="button is-success" onclick="confirmEmailSend()">Confirm &amp; Send</button>
        <button class="button" onclick="document.getElementById('email-modal').classList.remove('is-active')">Cancel</button>
      </footer>
    </div>
  </div>
  {{end}}

  <div id="accept-confirm" class="modal">
    <div class="modal-background" onclick="this.parentElement.classList.remove('is-active')"></div>
    <div class="modal-card" style="max-width:400px;">
      <header class="modal-card-head">
        <p class="modal-card-title">Accept Estimate</p>
        <button class="delete" aria-label="close" onclick="document.getElementById('accept-confirm').classList.remove('is-active')"></button>
      </header>
      <section class="modal-card-body">
        <p>By accepting this estimate you agree to the terms and conditions and authorize Columbia Outdoor to proceed with the project as described.</p>
      </section>
      <footer class="modal-card-foot">
        <form method="post" action="{{if .AcceptURL}}{{.AcceptURL}}{{else}}/patio-estimate{{end}}">
          <input type="hidden" name="accept" value="true">
          <input type="hidden" name="estimate_id" value="{{.EstimateID}}">
          <button class="button is-success" type="submit">Yes, Accept Estimate</button>
        </form>
        <button class="button" onclick="document.getElementById('accept-confirm').classList.remove('is-active')">Cancel</button>
      </footer>
    </div>
  </div>

  <script>
    const estimateData = {
      width:            {{.Width}},
      depth:            {{.Depth}},
      patioType:        {{.PatioType | jsStr}},
      roofSlope:        {{.RoofSlope}},
      diyMode:          {{.DIYMode}},
      customerState:    {{if .Customer.State}}{{.Customer.State | jsStr}}{{else}}"WA"{{end}},
      hasPostWrap:      {{.HasPostWrap}},
      hasFinishCeiling: {{.HasFinishCeiling}},
      hasPaintStain:    {{.HasPaintStain}},
      hasFinishHardware: {{.HasFinishHardware}},
      electricalLights:   {{.ElectricalLights}},
      electricalFans:     {{.ElectricalFans}},
      electricalSwitches: {{.ElectricalSwitches}},
      electricalOutlets:  {{.ElectricalOutlets}},
      permitLevel:      {{.PermitLevel}},
      discountCode:     {{.DiscountCode | jsStr}},
      customItems: [
        {{range .CustomItems}}
        { description: {{.Description | jsStr}}, notes: {{.Notes | jsStr}}, cost: {{.Cost}} },
        {{end}}
      ],
    };

    const canEditCustomItems = {{if and (not .IsPublicView) (or (eq $.Header.Role "contractor") $.Header.IsAdmin)}}true{{else}}false{{end}};

    function formatCost(n) {
      return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function openPatioModal() {
      document.getElementById('patio-width').value = estimateData.width;
      document.getElementById('patio-depth').value = estimateData.depth;
      document.getElementById('patio-type-select').value = estimateData.patioType;
      document.getElementById('patio-modal').classList.add('is-active');
    }

    function applyPatio() {
      const width = parseFloat(document.getElementById('patio-width').value);
      const depth = parseFloat(document.getElementById('patio-depth').value);
      if (isNaN(width) || width < 1) { alert('Please enter a valid width (1 ft or more)'); return; }
      if (isNaN(depth) || depth < 1) { alert('Please enter a valid depth (1 ft or more)'); return; }
      estimateData.width = width;
      estimateData.depth = depth;
      estimateData.patioType = document.getElementById('patio-type-select').value;
      const slopeEditable = estimateData.patioType === 'truss' || estimateData.patioType === 'timberframe';
      document.getElementById('roofslope-editbtn').style.display = slopeEditable ? '' : 'none';
      const ceilingEditable = estimateData.patioType === 'leanto' || estimateData.patioType === 'truss';
      document.getElementById('finishceiling-check').style.display = ceilingEditable ? '' : 'none';
      document.getElementById('patio-modal').classList.remove('is-active');
      calcAndUpdate();
    }

    function openRoofSlopeModal() {
      document.getElementById('roofslope-input').value = estimateData.roofSlope;
      document.getElementById('roofslope-modal').classList.add('is-active');
    }

    function applyRoofSlope() {
      const slope = parseInt(document.getElementById('roofslope-input').value, 10);
      if (isNaN(slope) || slope < 4) { alert('Roof slope must be 4:12 or steeper'); return; }
      estimateData.roofSlope = slope;
      document.getElementById('roofslope-modal').classList.remove('is-active');
      calcAndUpdate();
    }

    function toggleHasPostWrap(checked) {
      estimateData.hasPostWrap = checked;
      document.getElementById('postwrap-row').classList.toggle('zero-row', !checked);
      calcAndUpdate();
    }

    function toggleHasFinishCeiling(checked) {
      estimateData.hasFinishCeiling = checked;
      document.getElementById('finishceiling-row').classList.toggle('zero-row', !checked);
      calcAndUpdate();
    }

    function toggleHasPaintStain(checked) {
      estimateData.hasPaintStain = checked;
      document.getElementById('paintstain-row').classList.toggle('zero-row', !checked);
      calcAndUpdate();
    }

    function toggleHasFinishHardware(checked) {
      estimateData.hasFinishHardware = checked;
      document.getElementById('finishhardware-row').classList.toggle('zero-row', !checked);
      calcAndUpdate();
    }

    function openElectricalModal() {
      document.getElementById('electrical-lights-select').value = estimateData.electricalLights.toString();
      document.getElementById('electrical-fans-select').value = estimateData.electricalFans.toString();
      document.getElementById('electrical-switches-select').value = estimateData.electricalSwitches.toString();
      document.getElementById('electrical-outlets-select').value = estimateData.electricalOutlets.toString();
      document.getElementById('electrical-modal').classList.add('is-active');
    }

    function applyElectrical() {
      estimateData.electricalLights = parseInt(document.getElementById('electrical-lights-select').value, 10);
      estimateData.electricalFans = parseInt(document.getElementById('electrical-fans-select').value, 10);
      estimateData.electricalSwitches = parseInt(document.getElementById('electrical-switches-select').value, 10);
      estimateData.electricalOutlets = parseInt(document.getElementById('electrical-outlets-select').value, 10);
      document.getElementById('electrical-modal').classList.remove('is-active');
      calcAndUpdate();
    }

    function openPermitModal() {
      document.getElementById('permit-level-select').value = estimateData.permitLevel.toString();
      document.getElementById('permit-modal').classList.add('is-active');
    }

    function applyPermit() {
      const level = parseInt(document.getElementById('permit-level-select').value, 10);
      estimateData.permitLevel = level;
      document.getElementById('permit-modal').classList.remove('is-active');
      calcAndUpdate();
    }

    function applyDiscountCode() {
      const code = document.getElementById('discount-code-input').value.trim().toUpperCase();
      estimateData.discountCode = code;
      const saveField = document.getElementById('save-discount-code');
      if (saveField) saveField.value = code;
      calcAndUpdate();
    }

    function confirmEmailSend() {
        const emailInput = document.getElementById('email-input');
        const estimateID = document.getElementById('estimate-id').value;
        const email = emailInput.value.trim();
        if (!email || !email.includes('@')) { alert('Please enter a valid email address'); return; }
        const ccSelf = document.getElementById('cc-self-check');
        fetch(`/patio-estimate/send/${estimateID}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email, ccSelf: ccSelf ? ccSelf.checked : false })
        })
        .then(response => response.json())
        .then(data => {
            document.getElementById('email-modal').classList.remove('is-active');
            if (data.status === 'sent') {
                alert('Estimate successfully emailed to: ' + email);
            } else {
                alert(data.message || 'Email could not be sent. Please call us at (360) 787-8062.');
            }
        })
        .catch(err => {
            console.error('Send error:', err);
            alert('Email could not be sent. Please call us at (360) 787-8062.');
        });
    }

    // --- Custom line items ---
    function escHtml(str) {
      return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function syncCustomItems() {
      const field = document.getElementById('save-custom-items');
      if (field) field.value = JSON.stringify(estimateData.customItems.filter(ci => ci.description !== '' || ci.cost !== 0));
    }

    function renderCustomItems() {
      const container = document.getElementById('custom-items-rows');
      if (!container) return;
      let html = '';
      estimateData.customItems.forEach((item, idx) => {
        const cost = item.cost || 0;
        const costStyle = cost < 0 ? ' style="color:var(--est-accent);"' : '';
        const costDisplay = cost === 0 ? '—' : (cost < 0 ? '-' + formatCost(Math.abs(cost)) : formatCost(cost));
        if (canEditCustomItems) {
          html += `<tr>
            <td class="td-item">${escHtml(item.description)}</td>
            <td class="td-ctl" style="white-space:nowrap;">
              <a href="#" onclick="openCustomItemModal(${idx}); return false;" class="est-edit-btn" title="Edit"><i class="fas fa-pencil-alt"></i></a>
              <a href="#" onclick="removeCustomItem(${idx}); return false;" class="est-edit-btn" title="Remove" style="color:var(--est-red);"><i class="fas fa-times"></i></a>
            </td>
            <td class="td-desc">${escHtml(item.notes)}</td>
            <td class="td-cost"${costStyle}>${costDisplay}</td>
          </tr>`;
        } else if (item.description || cost !== 0) {
          html += `<tr>
            <td class="td-item">${escHtml(item.description)}</td>
            <td class="td-ctl"></td>
            <td class="td-desc">${escHtml(item.notes)}</td>
            <td class="td-cost"${costStyle}>${costDisplay}</td>
          </tr>`;
        }
      });
      container.innerHTML = html;
      syncCustomItems();
    }

    let customItemEditIdx = -1;

    function openCustomItemModal(idx) {
      customItemEditIdx = (idx !== undefined) ? idx : -1;
      const item = (idx !== undefined) ? estimateData.customItems[idx] : { description: '', notes: '', cost: 0 };
      document.getElementById('ci-item').value = item.description || '';
      document.getElementById('ci-notes').value = item.notes || '';
      document.getElementById('ci-cost').value = item.cost || '';
      document.getElementById('custom-item-modal').classList.add('is-active');
      setTimeout(() => document.getElementById('ci-item').focus(), 50);
    }

    function closeCustomItemModal() {
      document.getElementById('custom-item-modal').classList.remove('is-active');
    }

    function applyCustomItem() {
      const label = document.getElementById('ci-item').value.trim();
      const notes = document.getElementById('ci-notes').value.trim();
      const cost = parseFloat(document.getElementById('ci-cost').value) || 0;
      if (!label && cost === 0) { closeCustomItemModal(); return; }
      if (customItemEditIdx >= 0) {
        estimateData.customItems[customItemEditIdx] = { description: label, notes: notes, cost: cost };
      } else {
        estimateData.customItems.push({ description: label, notes: notes, cost: cost });
      }
      closeCustomItemModal();
      renderCustomItems();
      syncCustomItems();
      calcAndUpdate();
    }

    function removeCustomItem(idx) {
      estimateData.customItems.splice(idx, 1);
      renderCustomItems();
      syncCustomItems();
      calcAndUpdate();
    }

    renderCustomItems();

    function calcAndUpdate() {
      document.getElementById('save-width').value = estimateData.width;
      document.getElementById('save-depth').value = estimateData.depth;
      document.getElementById('save-patio-type').value = estimateData.patioType;
      document.getElementById('save-roof-slope').value = estimateData.roofSlope;
      document.getElementById('save-has-post-wrap').value = estimateData.hasPostWrap;
      document.getElementById('save-has-finish-ceiling').value = estimateData.hasFinishCeiling;
      document.getElementById('save-has-paint-stain').value = estimateData.hasPaintStain;
      document.getElementById('save-has-finish-hardware').value = estimateData.hasFinishHardware;
      document.getElementById('save-electrical-lights').value = estimateData.electricalLights;
      document.getElementById('save-electrical-fans').value = estimateData.electricalFans;
      document.getElementById('save-electrical-switches').value = estimateData.electricalSwitches;
      document.getElementById('save-electrical-outlets').value = estimateData.electricalOutlets;
      document.getElementById('save-permit-level').value = estimateData.permitLevel;
      syncCustomItems();

      const unsaved = document.getElementById('unsaved-msg');
      if (unsaved) unsaved.style.display = '';

      fetch('/api/calc/patio', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(estimateData),
      })
      .then(r => r.json())
      .then(data => {
        if (data.error) { console.error('Calc error:', data.error); return; }
        document.getElementById('patio-desc').textContent = data.patioDescription;
        document.getElementById('patio-cost').textContent = formatCost(data.baseCost);
        estimateData.roofSlope = data.roofSlope;
        document.getElementById('save-roof-slope').value = data.roofSlope;
        document.getElementById('roofslope-desc').textContent = data.roofSlopeDescription;
        document.getElementById('roofslope-cost').textContent = formatCost(data.roofSlopeCost);
        document.getElementById('postwrap-desc').textContent = data.postWrapDescription;
        document.getElementById('postwrap-cost').textContent = formatCost(data.postWrapCost);
        estimateData.hasFinishCeiling = data.hasFinishCeiling;
        document.getElementById('finishceiling-check').checked = data.hasFinishCeiling;
        document.getElementById('save-has-finish-ceiling').value = data.hasFinishCeiling;
        document.getElementById('finishceiling-row').classList.toggle('zero-row', !data.hasFinishCeiling && estimateData.patioType !== 'timberframe');
        document.getElementById('finishceiling-desc').textContent = data.finishCeilingDescription;
        document.getElementById('finishceiling-cost').textContent = formatCost(data.finishCeilingCost);
        document.getElementById('paintstain-desc').textContent = data.paintStainDescription;
        document.getElementById('paintstain-cost').textContent = formatCost(data.paintStainCost);
        document.getElementById('finishhardware-desc').textContent = data.finishHardwareDescription;
        document.getElementById('finishhardware-cost').textContent = formatCost(data.finishHardwareCost);
        document.getElementById('electrical-row').classList.toggle('zero-row', !data.hasElectrical);
        document.getElementById('electrical-desc').textContent = data.electricalDescription;
        document.getElementById('electrical-cost').textContent = formatCost(data.electricalCost);
        document.getElementById('permit-desc').textContent = data.permitDescription;
        document.getElementById('permit-cost').textContent = formatCost(data.permitCost);
        // Discount
        const discountRow = document.getElementById('discount-row-label');
        const msg = document.getElementById('discount-msg');
        if (data.discountAmount > 0) {
          document.getElementById('discount-desc').textContent = data.discountCode + ' — 10% off';
          document.getElementById('discount-val').textContent  = '-' + formatCost(data.discountAmount);
          if (discountRow) discountRow.style.display = '';
          if (msg) { msg.textContent = 'Discount applied!'; msg.className = 'help has-text-success'; }
        } else {
          if (discountRow) discountRow.style.display = 'none';
          const inp = document.getElementById('discount-code-input');
          if (msg && inp && inp.value.trim()) { msg.textContent = 'Invalid code.'; msg.className = 'help has-text-danger'; }
          else if (msg) { msg.textContent = ''; }
        }
        document.getElementById('subtotal-val').textContent = formatCost(data.subtotal);
        document.getElementById('salestax-val').textContent = formatCost(data.salesTax);
        document.getElementById('total-val').textContent = formatCost(data.totalCost);
        const headerTotal = document.getElementById('header-total');
        if (headerTotal) headerTotal.textContent = formatCost(data.totalCost);
      })
      .catch(err => console.error('API error:', err));
    }
  </script>
  {{end}}

  {{template "footer.gohtml" .}}
{{end}}
