{{define "estimate-patio.gohtml"}}
  {{template "header.gohtml" .Header}}

  {{with .Page}}
  <div style="max-width:480px;">
    {{if .Error}}
    <div class="notification is-danger">{{.Error}}</div>
    {{end}}

    <h2 class="title is-4">Patio Cover Estimate{{if gt .EstimateID 0}} #{{.EstimateID}}{{end}}</h2>
    {{if .Desc}}<p class="has-text-grey mb-4">{{.Desc}}</p>{{end}}

    <div class="box">
      <table class="patio-line-items">
        <colgroup>
          <col style="width:90px;">
          <col>
          <col style="width:90px;">
        </colgroup>
        <thead>
          <tr>
            <th>Item</th>
            <th>Description</th>
            <th class="td-cost">Cost</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="td-item">{{.PatioTypeLabel}}</td>
            <td class="td-desc">{{formatPatioDescription .}}</td>
            <td class="td-cost">{{formatCost .BaseCost}}</td>
          </tr>
        </tbody>
        <tbody>
          <tr class="row-subtotal">
            <td class="td-item">Subtotal</td>
            <td class="td-desc"></td>
            <td class="td-cost">{{formatCost .Subtotal}}</td>
          </tr>
          <tr class="row-tax">
            <td class="td-item">Sales Tax</td>
            <td class="td-desc">{{if .Customer.State}}{{.Customer.State}}{{else}}WA{{end}} (estimated)</td>
            <td class="td-cost">{{formatCost .SalesTax}}</td>
          </tr>
          <tr class="row-total">
            <td class="td-item">Total</td>
            <td class="td-desc"></td>
            <td class="td-cost">{{formatCost .TotalCost}}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <style>
      .patio-line-items { width: 100%; border-collapse: collapse; }
      .patio-line-items thead th {
        font-size: .7rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
        color: #7a7a7a; border-bottom: 1px solid #dbdbdb; padding: .35rem .4rem; text-align: left;
      }
      .patio-line-items thead th.td-cost { text-align: right; }
      .patio-line-items tbody td { padding: .5rem .4rem; border-bottom: 1px solid #f0f0f0; vertical-align: top; }
      .patio-line-items .td-item { font-weight: 600; color: #222; }
      .patio-line-items .td-desc { color: #555; font-size: .9rem; }
      .patio-line-items .td-cost {
        text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; color: #222;
      }
      .patio-line-items tr.row-subtotal td { border-top: 1px solid #dbdbdb; padding-top: .6rem; }
      .patio-line-items tr.row-tax td { border-bottom: none; }
      .patio-line-items tr.row-total td {
        font-weight: 700; font-size: 1.1rem; border-top: 2px solid #222; border-bottom: none; padding-top: .6rem;
      }
      .patio-line-items tr.row-total .td-cost { color: #1a5c32; }
    </style>

    {{if and (gt .EstimateID 0) (not .SaveDate.IsZero)}}
    <p class="has-text-grey is-size-7 mb-4">Estimate #{{.EstimateID}} &mdash; Version {{.Version}} &mdash; Saved {{.SaveDate.Format "Jan 2, 2006"}}</p>
    {{end}}

    <div class="box">
      <h3 class="title is-5">Contact Info</h3>
      {{if .Customer.FirstName}}
      <p>{{.Customer.FirstName}} {{.Customer.LastName}}</p>
      <p>{{.Customer.Address}}, {{.Customer.City}}, {{.Customer.State}} {{.Customer.Zip}}</p>
      <p>{{.Customer.PhoneNumber}} &middot; {{.Customer.Email}}</p>
      {{else}}
      <p class="has-text-grey">No contact info yet.</p>
      {{end}}
      <a href="/customer" class="button is-small mt-2">{{if .Customer.FirstName}}Edit{{else}}Add{{end}} Contact Info</a>
    </div>

    {{if .SaveDate.IsZero}}
      {{if .Customer.FirstName}}
      <form method="post" action="/patio-estimate">
        <input type="hidden" name="save" value="true">
        <button class="button is-primary is-fullwidth is-medium" type="submit"><i class="fas fa-save"></i> Save Estimate</button>
      </form>
      {{else}}
      <div class="notification is-warning is-light">Add your contact info above before saving.</div>
      {{end}}
    {{else}}
    <div class="notification is-success is-light">Estimate saved.</div>
    {{end}}

    {{if or .TermsHTML .Terms}}
    <div class="box mt-5">
      <h3 class="title is-5">Terms and Conditions</h3>
      {{if .TermsHTML}}<div class="content is-small">{{.TermsHTML}}</div>{{else}}<pre class="is-size-7">{{.Terms}}</pre>{{end}}
    </div>
    {{end}}
  </div>
  {{end}}

  {{template "footer.gohtml" .}}
{{end}}
