{{define "estimate-patio.gohtml"}}
  {{template "header.gohtml" .Header}}

  <link rel="stylesheet" type="text/css" href="/css/estimate.css">

  {{with .Page}}

  {{if .Error}}
  <div class="notification is-danger mb-4"><p>{{.Error}}</p></div>
  {{end}}

  {{/* ── HEADER CARD ── */}}
  <div class="est-header-card">
    <div>
      <p class="est-eyebrow">Columbia Outdoor{{if .Contractor.CompanyName}} &middot; {{.Contractor.CompanyName}}{{end}}</p>
      <h1 class="est-title">
        Patio Cover Estimate{{if gt .EstimateID 0}} #{{.EstimateID}}{{if .Version}}-{{.Version}}{{end}}{{end}}
      </h1>
      <div class="est-project-line">
        {{if .Desc}}
        <span class="est-project">{{.Desc}}</span>
        {{else}}
        <span class="est-project" style="color:var(--est-text3);">No description added</span>
        {{end}}
      </div>
      <div class="est-status-wrap">
        {{if .Status}}
        <span class="est-status-pill {{if eq .Status "Accepted"}}pill-accepted{{else if eq .Status "Expired"}}pill-expired{{else}}pill-pending{{end}}">
          {{if eq .Status "Accepted"}}&#10003; {{end}}{{.Status}}
        </span>
        {{end}}
        {{if and (gt .EstimateID 0) (not .SaveDate.IsZero)}}
          {{if not .AcceptDate.IsZero}}
          <span class="est-date-note">Accepted {{.AcceptDate.Format "Jan 2, 2006"}}</span>
          {{else}}
            {{if not .ExpirationDate.IsZero}}
            <span class="est-date-note">Expires {{.ExpirationDate.Format "Jan 2, 2006"}}</span>
            {{end}}
          {{end}}
        {{end}}
      </div>
      {{if and (gt .EstimateID 0) (not .SaveDate.IsZero)}}
      <p class="est-date-note">Version {{.Version}} &mdash; Saved {{.SaveDate.Format "Jan 2, 2006"}}</p>
      {{end}}
    </div>
    {{if .TotalCost}}
    <div class="est-total-callout">
      <p class="est-total-label">Estimated Total</p>
      <p class="est-total-amount">{{formatCost .TotalCost}}</p>
      <p class="est-total-note">Incl. {{if .Customer.State}}{{.Customer.State}}{{else}}WA{{end}} sales tax</p>
    </div>
    {{end}}
  </div>

  {{/* ── TIER TOGGLE ── */}}
  <div class="est-tier-bar">
    <span class="est-tier-label">Service Tier</span>
    <div class="est-tier-group">
      <button type="button" class="est-tier-btn{{if eq .DIYMode 0}} tier-active-full{{end}}">
        <i class="fas fa-hard-hat"></i> Full Service
      </button>
      <button type="button" class="est-tier-btn{{if eq .DIYMode 1}} tier-active-plans{{end}}">
        <i class="fas fa-tools"></i> Plans + Materials
      </button>
      <button type="button" class="est-tier-btn{{if eq .DIYMode 2}} tier-active-diy{{end}}">
        <i class="fas fa-drafting-compass"></i> Plans Only
      </button>
    </div>
  </div>

  {{/* ── ACTION BAR ── */}}
  <div class="est-action-bar">
    <button id="btn-email" class="est-btn" type="button">
      <i class="fas fa-envelope"></i> Email
    </button>
    <button id="btn-materials" class="est-btn" type="button">
      <i class="fas fa-hammer"></i> Generate Materials
    </button>
    <button id="btn-print" class="est-btn" type="button">
      <i class="fas fa-print"></i> Print
    </button>
  </div>

  {{/* ── PARTY CARDS ── */}}
  <div class="est-parties">
    <div class="est-party-card">
      <p class="est-party-role">From</p>
      {{if .Contractor.CompanyName}}
      <p class="est-party-name">{{.Contractor.CompanyName}}</p>
      <div class="est-party-detail">
        {{if .Contractor.Phone}}<div>{{.Contractor.Phone}}</div>{{end}}
        {{if .Contractor.Website}}<div><a href="{{.Contractor.Website}}" target="_blank">{{.Contractor.Website}}</a></div>{{end}}
        {{if .Contractor.LicenseNum}}<div>License: {{.Contractor.LicenseNum}} ({{.Contractor.LicenseState}})</div>{{end}}
      </div>
      {{else}}
      <p class="est-party-name">Columbia Outdoor</p>
      <div class="est-party-detail">
        <div>(360) 787-8062</div>
        <div>columbiaoutdoor.com</div>
      </div>
      {{end}}
    </div>

    <div class="est-party-card">
      <p class="est-party-role">
        <span>{{if eq $.Header.Role "contractor"}}Customer{{else}}Prepared For{{end}}</span>
        {{if eq .Customer.FirstName ""}}
        <a href="/customer" class="est-party-edit" style="color:var(--est-red); border-color:#f5c6c2;">
          {{if eq $.Header.Role "contractor"}}+ Add Customer{{else}}+ Add Your Info{{end}}
        </a>
        {{else}}
        <a href="/customer" class="est-party-edit">Edit</a>
        {{end}}
      </p>
      {{if or .Customer.FirstName .Customer.LastName}}
      <p class="est-party-name">{{.Customer.FirstName}} {{.Customer.LastName}}</p>
      {{else}}
      <p class="est-party-missing">No customer info added yet</p>
      {{end}}
      <div class="est-party-detail">
        {{if .Customer.Address}}<div>{{.Customer.Address}}</div>{{end}}
        {{if or .Customer.City .Customer.State}}<div>{{.Customer.City}}{{if and .Customer.City .Customer.State}}, {{end}}{{.Customer.State}} {{.Customer.Zip}}</div>{{end}}
        {{if .Customer.PhoneNumber}}<div>{{.Customer.PhoneNumber}}</div>{{end}}
        {{if .Customer.Email}}<div>{{.Customer.Email}}</div>{{end}}
      </div>
    </div>
  </div>

  {{/* ── SCOPE TABLE ── */}}
  <div class="est-scope-card">
    <div class="est-scope-head">
      <span class="est-scope-title">Scope of Work</span>
    </div>
    <div class="est-scope-table-wrap">
    <table class="est-line-items">
      <colgroup>
        <col class="col-item">
        <col class="col-ctl">
        <col>
        <col class="col-cost">
      </colgroup>
      <thead>
        <tr>
          <th>Item</th>
          <th></th>
          <th>Description</th>
          <th class="th-cost">Cost</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="td-item">{{.PatioTypeLabel}}</td>
          <td class="td-ctl"></td>
          <td class="td-desc">{{formatPatioDescription .}}</td>
          <td class="td-cost">{{formatCost .BaseCost}}</td>
        </tr>

        {{/* Roof Slope */}}
        <tr>
          <td class="td-item">Roof Slope</td>
          <td class="td-ctl"></td>
          <td class="td-desc">{{formatPatioRoofSlopeDescription .}}</td>
          <td class="td-cost">{{formatCost 0.0}}</td>
        </tr>

        {{/* Post Wrap */}}
        <tr{{if not .HasPostWrap}} class="zero-row"{{end}}>
          <td class="td-item">Post Wrap</td>
          <td class="td-ctl"><input type="checkbox" class="est-check" {{if .HasPostWrap}}checked{{end}}></td>
          <td class="td-desc">{{formatPatioPostWrapDescription .}}</td>
          <td class="td-cost">{{formatCost .PostWrapCost}}</td>
        </tr>

        {{/* Finish Ceiling */}}
        <tr{{if not .HasFinishCeiling}} class="zero-row"{{end}}>
          <td class="td-item">Finish Ceiling</td>
          <td class="td-ctl"><input type="checkbox" class="est-check" {{if .HasFinishCeiling}}checked{{end}}></td>
          <td class="td-desc">{{formatPatioFinishCeilingDescription .}}</td>
          <td class="td-cost">{{formatCost .FinishCeilingCost}}</td>
        </tr>

        {{/* Paint or Stain */}}
        <tr{{if not .HasPaintStain}} class="zero-row"{{end}}>
          <td class="td-item">Paint or Stain</td>
          <td class="td-ctl"><input type="checkbox" class="est-check" {{if .HasPaintStain}}checked{{end}}></td>
          <td class="td-desc">{{formatPatioPaintStainDescription .}}</td>
          <td class="td-cost">{{formatCost .PaintStainCost}}</td>
        </tr>
      </tbody>
      <tbody>
        <tr class="est-subtotal-row">
          <td class="td-item">Subtotal</td>
          <td class="td-ctl"></td>
          <td class="td-desc"></td>
          <td class="td-cost">{{formatCost .Subtotal}}</td>
        </tr>
        <tr class="est-tax-row">
          <td class="td-item">Sales Tax</td>
          <td class="td-ctl"></td>
          <td class="td-desc">{{if .Customer.State}}{{.Customer.State}}{{else}}WA{{end}} (estimated)</td>
          <td class="td-cost">{{formatCost .SalesTax}}</td>
        </tr>
        <tr class="est-total-row">
          <td class="td-item">Total</td>
          <td class="td-ctl"></td>
          <td class="td-desc">
            {{if not .ExpirationDate.IsZero}}Valid through {{.ExpirationDate.Format "Jan 2, 2006"}}{{end}}
          </td>
          <td class="td-cost">{{formatCost .TotalCost}}</td>
        </tr>
      </tbody>
    </table>
    </div>
  </div>

  <div style="max-width:480px;">
    {{if .SaveDate.IsZero}}
      {{if .Customer.FirstName}}
      <form method="post" action="/patio-estimate">
        <input type="hidden" name="save" value="true">
        <button class="button is-primary is-fullwidth is-medium" type="submit"><i class="fas fa-save"></i> Save Estimate</button>
      </form>
      {{else}}
      <div class="notification is-warning is-light">Add your contact info above before saving.</div>
      {{end}}
    {{else}}
    <div class="notification is-success is-light">Estimate saved.</div>
    {{end}}

    {{if or .TermsHTML .Terms}}
    <div class="box mt-5">
      <h3 class="title is-5">Terms and Conditions</h3>
      {{if .TermsHTML}}<div class="content is-small">{{.TermsHTML}}</div>{{else}}<pre class="is-size-7">{{.Terms}}</pre>{{end}}
    </div>
    {{end}}
  </div>
  {{end}}

  {{template "footer.gohtml" .}}
{{end}}
