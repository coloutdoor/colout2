<!DOCTYPE html>
<html lang="en-us">
  <head>

    <!-- Microsoft Advertising UET tag -->
    <script>(function(w, d, t, u, o) {w[u] = w[u] || [], o.ts = (new Date).getTime();var n = d.createElement(t);n.src = "https://bat.bing.net/bat.js?ti=" + o.ti + ("uetq" != u ? "&q=" + u : ""),n.async = 1, n.onload = n.onreadystatechange = function() {var s = this.readyState;s && "loaded" !== s && "complete" !== s ||(o.q = w[u], w[u] = new UET(o), w[u].push("pageLoad"),n.onload = n.onreadystatechange = null)};var i = d.getElementsByTagName(t)[0];i.parentNode.insertBefore(n, i);})(window, document, "script", "uetq", {ti:"97262921",enableAutoSpaTracking: true});</script>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9L9L1S3G0W"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-9L9L1S3G0W');
    </script>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta http-equiv='content-language' content='en-us'>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content=" {{if .MetaDesc}} {{.MetaDesc}} {{else}} Deck Builders SW Washington {{end}}">

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content="Columbia Outdoor — Outdoor Living Estimates">
    <meta property="og:description" content="Get an instant deck, patio cover, or pergola estimate. No surprises, transparent pricing, vetted contractors. Serving SW Washington.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://columbiaoutdoor.com/">
    <meta property="og:image" content="https://storage.googleapis.com/columbiaoutdoor-images/deck1.jpeg">
    <meta property="og:site_name" content="Columbia Outdoor">

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Columbia Outdoor — Outdoor Living Estimates">
    <meta name="twitter:description" content="Get an instant deck, patio cover, or pergola estimate. Transparent pricing, vetted contractors. Serving SW Washington.">
    <meta name="twitter:image" content="https://storage.googleapis.com/columbiaoutdoor-images/deck1.jpeg">

    <!-- Additional SEO Meta Tags -->
    <meta name="keywords" content="deck builder pacific northwest, patio cover washington, pergola washington, Kalama, Woodland, Ridgefield, La Center, columbia outdoor woodland wa, estimate calculator">
    <meta name="robots" content="index, follow">
    <meta name="geo.region" content="US-WA">
    <meta name="geo.placename" content="Woodland, WA">
    <meta name="author" content="Columbia Outdoor">

    <!-- Canonical -->
    <link rel="canonical" href="https://columbiaoutdoor.com{{if .CanonicalPath}}{{.CanonicalPath}}{{end}}">
    <link rel="shortcut icon" href="/images/colout2.png" type="image/x-icon">
    <title>{{if .Title}} {{.Title}} {{else}} Outdoor Living {{end}} | Columbia Outdoor</title>

    <!--
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" 
      integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" 
      crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link href="https://fonts.googleapis.com/css?family=Open+Sans" rel="stylesheet">
    <!-- Bulma Version 1-->
    <link rel="stylesheet" href="https://unpkg.com/bulma@1.0.4/css/bulma.min.css" />
    <!--link rel="stylesheet" href="https://unpkg.com/bulma-modal-fx/dist/css/modal-fx.min.css" /-->
    <link rel="stylesheet" type="text/css" href="/css/colout.css">
    <style>
    ::-webkit-scrollbar{height:10px;width:10px}::-webkit-scrollbar-track{background:#efefef;border-radius:6px}::-webkit-scrollbar-thumb{background:#d5d5d5;border-radius:6px}::-webkit-scrollbar-thumb:hover{background:#c4c4c4}
    .navbar-item { font-size: 1rem; }
    /* Pro mode bar */
    .pro-bar {
      background: #0d2035;
      border-top: 1px solid #1a3450;
      border-bottom: 1px solid #1a3450;
      padding: .35rem 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .pro-bar-left {
      display: flex;
      align-items: center;
      gap: .6rem;
    }
    .pro-badge {
      display: inline-flex;
      align-items: center;
      gap: .3rem;
      background: #1a3328;
      color: #3d8c65;
      border: 1px solid #2a5c44;
      border-radius: 4px;
      font-size: .65rem;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
      padding: .15rem .45rem;
      line-height: 1;
    }
    .pro-bar-name {
      font-size: .8rem;
      font-weight: 600;
      color: #d8eaf8;
    }
    .pro-bar-sub {
      font-size: .75rem;
      color: #3f6080;
    }
    .pro-bar-link {
      font-size: .78rem;
      font-weight: 600;
      color: #3d8c65;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: .3rem;
      white-space: nowrap;
    }
    .pro-bar-link:hover { color: #4aaa7a; }
    /* PRO badge in navbar brand */
    .navbar-pro-badge {
      display: inline-flex;
      align-items: center;
      background: #1a3328;
      color: #3d8c65;
      border: 1px solid #2a5c44;
      border-radius: 4px;
      font-size: .6rem;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
      padding: .1rem .35rem;
      margin-left: .35rem;
      line-height: 1;
      vertical-align: middle;
    }
    </style>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  </head>
  <body>

  <!-- ==== BULMA NAVBAR (brand + menu) ==== -->
  <nav class="navbar is-light" role="navigation" aria-label="main navigation">
    <div class="container">
    <div class="navbar-brand">
      <a class="navbar-item" href="/">
        <img src="/images/colout2.png" alt="Columbia Outdoor" style="max-height:44px; width:auto;">
      </a>
      {{if and .IsAuthenticated .CompanyName}}
      <a class="navbar-item" href="/my-estimates">
        <strong>{{.CompanyName}}</strong>
        {{if eq .ContractorStatus "approved"}}<span class="navbar-pro-badge">PRO</span>{{end}}
      </a>
      {{end}}

      <!-- HAMBURGER (mobile) -->
      <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false"
         data-target="mainNavbar">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </a>
    </div>

    <div id="mainNavbar" class="navbar-menu">
      <div class="navbar-end">
        <a class="navbar-item" href="/">Home</a>
      {{if .IsAuthenticated}}
        <a class="navbar-item" href="/login?option=signout">Sign Out</a>
      {{else}}
        <a class="navbar-item" href="/login">Log in</a>
      {{end}}
        <a class="navbar-item" href="/contact">Contact Us</a>
        {{if and .IsAuthenticated (not .CompanyName)}}
        <div class="navbar-item">
          <a href="/my-estimates" class="button" style="background-color:#3d8c65; border-color:#2a5c44; color:white;">
            <strong>My Estimates</strong>
          </a>
        </div>
        {{end}}
        <div class="navbar-item">
          <a href="/deck-calculator?option=deck" class="button" style="background-color:#6b7280; border-color:#6b7280; color:white;">
            <strong>Deck Calculator</strong>
          </a>
        </div>
      </div>
    </div>
    </div>
  </nav>

  {{if eq .ContractorStatus "approved"}}
  <div class="pro-bar">
    <div class="pro-bar-left">
      <span class="pro-badge"><i class="fas fa-briefcase"></i> Professional</span>
      <span class="pro-bar-name">{{if .CompanyName}}{{.CompanyName}}{{else}}{{.Email}}{{end}}</span>
      <span class="pro-bar-sub">Contractor Mode</span>
    </div>
    <a class="pro-bar-link" href="/my-estimates">
      <i class="fas fa-list"></i> All Estimates
    </a>
  </div>
  {{end}}

    <section class="section container">
    <!-- Page Content Starts Below -->