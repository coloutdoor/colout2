{{define "projects.gohtml"}}
{{template "header.gohtml" .Header}}

{{with .Page}}
<section class="section has-background-white">
  <div class="container">
    <h1 class="title is-2 has-text-centered has-text-dark mb-2">Our Projects</h1>
    <p class="subtitle has-text-grey has-text-centered mb-6">Browse completed decks, covers, and outdoor structures.</p>

    {{if eq (len .Projects) 0}}
    <p class="has-text-centered has-text-grey">No projects to show yet.</p>
    {{else}}
    <div class="proj-filter-row">
      <label class="ap-label" for="categoryFilter" style="text-transform:none;letter-spacing:normal;font-weight:600;color:#4a5568;">Filter by category</label>
      {{$sel := .SelectedCategory}}
      <select id="categoryFilter" class="proj-filter-select" onchange="filterByCategory(this.value)">
        <option value="" {{if eq $sel ""}}selected{{end}}>All Categories</option>
        {{range .Categories}}
        <option value="{{.Value}}" {{if eq .Value $sel}}selected{{end}}>{{.Label}}</option>
        {{end}}
      </select>
    </div>

    <div class="proj-grid" id="projGrid">
      {{range .Projects}}
      <div class="proj-card" onclick="openProjectModal(this)"
        data-project="{{.Name}}"
        data-photos="{{projectPhotosJSON .Photos}}"
        data-default-uri="{{.Cover.URI}}"
        data-default-desc="{{.Cover.Description}}">
        <img src="{{.Cover.URI}}" loading="lazy" alt="{{.Cover.Description}}">
        <div class="proj-card-label">{{.Name}}</div>
      </div>
      {{end}}
    </div>
    <p class="has-text-centered has-text-grey" id="projEmpty" style="display:none;">No projects match this category.</p>
    {{end}}
  </div>
</section>
{{end}}

<!-- Project Photo Modal -->
<div class="proj-modal-overlay" id="projModalOverlay" onclick="closeOnProjOverlay(event)">
  <div class="proj-modal">
    <button class="proj-modal-close" onclick="closeProjectModal()" aria-label="Close">&times;</button>
    <div class="proj-modal-slides" id="projSlides"></div>
    <button class="proj-modal-nav proj-modal-prev" onclick="projSlide(-1)" aria-label="Previous">&#8249;</button>
    <button class="proj-modal-nav proj-modal-next" onclick="projSlide(1)" aria-label="Next">&#8250;</button>
    <div class="proj-modal-caption" id="projCaption"></div>
    <div class="proj-modal-counter" id="projCounter"></div>
  </div>
</div>

<style>
.proj-filter-row {
  display: flex;
  align-items: center;
  gap: .6rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}
.proj-filter-select {
  background: #fff;
  border: 1px solid #d0d7de;
  border-radius: 6px;
  color: #2c3e50;
  font-size: .9rem;
  padding: .45rem .7rem;
  font-family: inherit;
}
.proj-filter-select:focus { outline: none; border-color: #3273dc; }
.proj-card.is-hidden { display: none; }

.proj-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 1.25rem;
}
.proj-card {
  cursor: pointer;
  border-radius: 8px;
  overflow: hidden;
  position: relative;
  box-shadow: 0 1px 4px rgba(0,0,0,.15);
  transition: transform .15s, box-shadow .15s;
}
.proj-card:hover { transform: translateY(-3px); box-shadow: 0 4px 12px rgba(0,0,0,.2); }
.proj-card img {
  width: 100%;
  aspect-ratio: 4/3;
  object-fit: cover;
  display: block;
}
.proj-card-label {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: .6rem .75rem;
  background: linear-gradient(transparent, rgba(0,0,0,.75));
  color: #fff;
  font-weight: 600;
  font-size: .95rem;
}

.proj-modal-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.85);
  z-index: 1000;
  align-items: center;
  justify-content: center;
  padding: 2.5rem 1rem;
}
.proj-modal-overlay.open { display: flex; }
.proj-modal {
  position: relative;
  width: 90vw;
  max-width: 1000px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.proj-modal-slides {
  width: 100%;
  max-height: 75vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.proj-modal-slides img {
  max-width: 100%;
  max-height: 75vh;
  object-fit: contain;
  border-radius: 6px;
}
.proj-modal-close {
  position: absolute;
  top: -2.5rem;
  right: 0;
  background: none;
  border: none;
  color: #fff;
  font-size: 2rem;
  line-height: 1;
  cursor: pointer;
}
.proj-modal-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(255,255,255,.15);
  border: none;
  color: #fff;
  border-radius: 50%;
  width: 2.75rem;
  height: 2.75rem;
  font-size: 1.4rem;
  cursor: pointer;
}
.proj-modal-nav:hover { background: rgba(255,255,255,.3); }
.proj-modal-prev { left: -.5rem; }
.proj-modal-next { right: -.5rem; }
.proj-modal-caption {
  color: #eee;
  text-align: center;
  margin-top: .75rem;
  font-size: .95rem;
}
.proj-modal-counter {
  color: #999;
  font-size: .8rem;
  margin-top: .25rem;
}

@media (max-width: 640px) {
  .proj-modal-prev { left: .25rem; }
  .proj-modal-next { right: .25rem; }
}
</style>

<script>
let projPhotos = [];
let projIndex = 0;

function filterByCategory(category) {
  const cards = document.querySelectorAll('.proj-card');
  let visibleCount = 0;

  cards.forEach(function(card) {
    const photos = JSON.parse(card.dataset.photos);
    const img = card.querySelector('img');

    if (!category) {
      card.classList.remove('is-hidden');
      img.src = card.dataset.defaultUri;
      img.alt = card.dataset.defaultDesc;
      visibleCount++;
      return;
    }

    const matches = photos.filter(function(p) { return p.category === category; });
    if (matches.length === 0) {
      card.classList.add('is-hidden');
      return;
    }
    const cover = matches.find(function(p) { return p.featured; }) || matches[0];
    card.classList.remove('is-hidden');
    img.src = cover.uri;
    img.alt = cover.description || '';
    visibleCount++;
  });

  const emptyMsg = document.getElementById('projEmpty');
  if (emptyMsg) emptyMsg.style.display = visibleCount === 0 ? 'block' : 'none';
}

function openProjectModal(card) {
  try {
    projPhotos = JSON.parse(card.dataset.photos);
  } catch (e) {
    projPhotos = [];
  }
  projIndex = 0;
  renderProjSlide();
  document.getElementById('projModalOverlay').classList.add('open');
}

function closeProjectModal() {
  document.getElementById('projModalOverlay').classList.remove('open');
}

function closeOnProjOverlay(e) {
  if (e.target === document.getElementById('projModalOverlay')) closeProjectModal();
}

function projSlide(dir) {
  if (projPhotos.length === 0) return;
  projIndex = (projIndex + dir + projPhotos.length) % projPhotos.length;
  renderProjSlide();
}

function renderProjSlide() {
  const slides  = document.getElementById('projSlides');
  const caption = document.getElementById('projCaption');
  const counter = document.getElementById('projCounter');
  slides.innerHTML = '';
  if (projPhotos.length === 0) {
    caption.textContent = '';
    counter.textContent = '';
    return;
  }
  const p = projPhotos[projIndex];
  const img = document.createElement('img');
  img.src = p.uri;
  img.alt = p.description || '';
  slides.appendChild(img);
  caption.textContent = p.description || '';
  counter.textContent = (projIndex + 1) + ' of ' + projPhotos.length;
}

document.addEventListener('keydown', function(e) {
  const overlay = document.getElementById('projModalOverlay');
  if (!overlay.classList.contains('open')) return;
  if (e.key === 'Escape')     closeProjectModal();
  if (e.key === 'ArrowLeft')  projSlide(-1);
  if (e.key === 'ArrowRight') projSlide(1);
});

(function() {
  var initialCategory = {{jsStr .Page.SelectedCategory}};
  if (initialCategory) filterByCategory(initialCategory);
})();
</script>

{{template "footer.gohtml" .}}
{{end}}
