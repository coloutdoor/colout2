{{define "customer.gohtml"}}
  {{template "header.gohtml" .Header}}

  {{with .Page}}
  <form method="post" action="/customer" class="box" style="max-width:480px;">

    <h2 class="title is-4">
      {{if .IsHomeowner}}Your Contact Information{{else}}Customer Information{{end}}
    </h2>
    {{if .IsHomeowner}}
    <p class="help mb-4">We'll use this to send you a copy of the estimate.</p>
    {{else}}
    <p class="help mb-4">Enter your customer's contact details for the estimate.</p>
    {{end}}

    <div class="field">
      <label class="label">First Name</label>
      <div class="control">
        <input class="input" type="text" name="firstName" value="{{.FirstName}}" required>
      </div>
    </div>

    <div class="field">
      <label class="label">Last Name</label>
      <div class="control">
        <input class="input" type="text" name="lastName" value="{{.LastName}}" required>
      </div>
    </div>

    <div class="field">
      <label class="label">Address</label>
      <div class="control">
        <input class="input" type="text" name="address" value="{{.Address}}" required>
      </div>
    </div>

    <div class="field">
      <label class="label">City</label>
      <div class="control">
        <input class="input" type="text" name="city" value="{{.City}}" required>
      </div>
    </div>

    <div class="field">
      <label class="label">State</label>
      <div class="control">
        <div class="select is-fullwidth">
          <select name="state" required>
            <option value="WA" {{if eq .State "WA"}}selected{{else if eq .State ""}}selected{{end}}>WA — Washington</option>
            <option value="OR" {{if eq .State "OR"}}selected{{end}}>OR — Oregon</option>
            <option value="ID" {{if eq .State "ID"}}selected{{end}}>ID — Idaho</option>
          </select>
        </div>
      </div>
    </div>

    <div class="field">
      <label class="label">Zip</label>
      <div class="control">
        <input class="input" type="text" name="zip" value="{{.Zip}}" required>
      </div>
    </div>

    <div class="field">
      <label class="label">Phone</label>
      <div class="control">
        <input class="input" type="tel" name="phoneNumber" value="{{.PhoneNumber}}" required>
      </div>
    </div>

    <div class="field">
      <label class="label">Email</label>
      <div class="control">
        <input class="input" type="email" name="email" value="{{.Email}}" required>
      </div>
    </div>

    <div class="field mt-5">
      <div class="control">
        <input class="button is-primary is-fullwidth is-medium" type="submit"
          value="{{if .IsHomeowner}}Save My Info{{else}}Save Customer{{end}}">
      </div>
    </div>

  </form>
  {{end}}
  {{template "footer.gohtml" .}}
{{end}}
