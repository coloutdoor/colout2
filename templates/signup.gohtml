{{define "signup.gohtml"}}
{{template "header.gohtml" .Header}}

{{with .Page}}
<section class="section">
  <div class="container" style="max-width:480px;">
    <div class="box">
      <h1 class="title has-text-centered">Create your account</h1>
      <p class="subtitle has-text-centered has-text-grey is-6">
        SW Washington's trusted outdoor platform
      </p>

      {{if .Message}}
        <div class="notification is-danger is-light">
          <button class="delete" onclick="this.parentElement.remove()"></button>
          {{.Message}}
        </div>
      {{end}}

      <form action="/signup" method="post">

        <div class="field">
          <label class="label">First Name <span class="has-text-danger">*</span></label>
          <div class="control has-icons-left">
            <input class="input" type="text" name="firstName" placeholder="John" required autofocus>
            <span class="icon is-small is-left"><i class="fas fa-user"></i></span>
          </div>
        </div>

        <div class="field">
          <label class="label">Last Name <span class="has-text-danger">*</span></label>
          <div class="control has-icons-left">
            <input class="input" type="text" name="lastName" placeholder="Doe" required>
            <span class="icon is-small is-left"><i class="fas fa-user"></i></span>
          </div>
        </div>

        <div class="field">
          <label class="label">Email <span class="has-text-danger">*</span></label>
          <div class="control has-icons-left">
            <input class="input" type="email" name="email" placeholder="you@example.com" required>
            <span class="icon is-small is-left"><i class="fas fa-envelope"></i></span>
          </div>
        </div>

        <div class="field">
          <label class="label">Phone <span class="has-text-grey is-size-7">(optional)</span></label>
          <div class="control has-icons-left">
            <input class="input" type="tel" name="phone" placeholder="(360) 555-0100">
            <span class="icon is-small is-left"><i class="fas fa-phone"></i></span>
          </div>
        </div>

        <div class="field">
          <label class="label">Address <span class="has-text-grey is-size-7">(optional — pre-fills estimates)</span></label>
          <div class="control">
            <input class="input" type="text" name="address" placeholder="123 Main St">
          </div>
        </div>

        <div class="field">
          <label class="label">City <span class="has-text-grey is-size-7">(optional)</span></label>
          <div class="control">
            <input class="input" type="text" name="city" placeholder="Woodland">
          </div>
        </div>

        <div class="field">
          <label class="label">State <span class="has-text-grey is-size-7">(optional)</span></label>
          <div class="control">
            <div class="select is-fullwidth">
              <select name="state">
                <option value="">-- Select --</option>
                <option value="WA">WA — Washington</option>
              </select>
            </div>
          </div>
        </div>

        <div class="field">
          <label class="label">Zip <span class="has-text-grey is-size-7">(optional)</span></label>
          <div class="control">
            <input class="input" type="text" name="zip" placeholder="98674">
          </div>
        </div>

        <hr>

        <div class="field">
          <label class="label">Password <span class="has-text-danger">*</span></label>
          <div class="control has-icons-left">
            <input class="input" type="password" name="password" placeholder="••••••••" required minlength="8">
            <span class="icon is-small is-left"><i class="fas fa-lock"></i></span>
          </div>
        </div>

        <div class="field">
          <label class="label">Confirm Password <span class="has-text-danger">*</span></label>
          <div class="control has-icons-left">
            <input class="input" type="password" name="password2" placeholder="••••••••" required minlength="8">
            <span class="icon is-small is-left"><i class="fas fa-lock"></i></span>
          </div>
        </div>

        <div class="field mt-5">
          <button class="button is-primary is-fullwidth is-medium">
            Create Account
          </button>
        </div>

      </form>

      <div class="has-text-centered mt-4">
        <p>Already have an account? <a href="/login">Log in</a></p>
      </div>
    </div>
  </div>
</section>
{{end}}
{{template "footer.gohtml" .}}
{{end}}
