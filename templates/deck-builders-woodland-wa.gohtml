{{define "deck-builders-woodland-wa.gohtml"}}
  {{template "header.gohtml" .Header}}

  <!-- Hero -->
  <section class="section" style="background: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url('https://storage.googleapis.com/columbiaoutdoor-images/photos-0405.jpg') center/cover no-repeat; padding: 5rem 1.5rem;">
    <div class="container has-text-centered">
      <h1 class="title is-1 has-text-white">Deck Builders in Woodland, WA</h1>
      <p class="subtitle has-text-white mt-4" style="max-width:700px; margin:1.5rem auto;">
        Stop chasing bids. Start building. Columbia Outdoor delivers
        <strong class="has-text-warning">transparent pricing, quality craftsmanship, and expert project management</strong>
        for custom decks across Woodland and the surrounding Pacific Northwest.
      </p>
      <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;">
        <a href="/deck-calculator?option=deck" class="button is-warning is-large is-rounded mt-4"><strong>Get a Free Estimate</strong></a>
        <a href="/contact" class="button is-light is-large is-rounded mt-4">Talk to a Professional</a>
      </div>
      <p class="has-text-white-ter mt-3 is-size-7">
        Serving Woodland, Kalama, Castle Rock, Ridgefield, La Center, and all of Clark and Cowlitz County, SW Washington.
      </p>
    </div>
  </section>

  <!-- Deck Materials -->
  <section class="section has-background-light">
    <div class="container">
      <h2 class="title is-3 has-text-centered has-text-dark mb-6">Deck Materials We Build With</h2>
      <div class="columns">
        <div class="column">
          <div class="box" style="height:100%;">
            <p class="title is-5">Composite Decking</p>
            <p class="has-text-grey mb-3">
              Trex, Timbertech, and Fiberon boards that hold their color and never need staining —
              built to handle SW Washington's rain and seasons for decades.
            </p>
            <ul>
              <li>Trex, Timbertech, and Fiberon board lines</li>
              <li>Hidden fastener and picture-frame finishes</li>
              <li>Manufacturer-backed fade and stain warranties</li>
            </ul>
          </div>
        </div>
        <div class="column">
          <div class="box" style="height:100%;">
            <p class="title is-5">Cedar &amp; Wood Decks</p>
            <p class="has-text-grey mb-3">
              A classic, natural look at a lower up-front cost — built with quality lumber and
              solid framing that lasts.
            </p>
            <ul>
              <li>Cedar decking and cedar rail systems</li>
              <li>Pressure-treated structural framing</li>
              <li>Repairs, board replacement, and refinishing</li>
            </ul>
          </div>
        </div>
        <div class="column">
          <div class="box" style="height:100%;">
            <p class="title is-5">Rail &amp; Railing Systems</p>
            <p class="has-text-grey mb-3">
              Aluminum, cable, and glass infill rail systems to match your deck's style and keep
              sightlines open.
            </p>
            <ul>
              <li>Aluminum rail with cable or glass infill</li>
              <li>Custom cedar rail and picture-frame accents</li>
              <li>Engineered for local code and snow loads</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section">
    <div class="container" style="max-width:780px;">
      <h2 class="title is-3 has-text-centered mb-2">Why Woodland Homeowners Choose Columbia Outdoor</h2>
      <p class="has-text-centered has-text-grey mb-5">
        Columbia Outdoor's experienced team handles your deck project from estimate to final walkthrough.
        One point of contact, transparent pricing, and craftsmen who take pride in their work.
      </p>
      <div style="display:flex; flex-direction:column; gap:1rem;">
        <div style="display:flex; align-items:flex-start; gap:1rem;">
          <span class="icon has-text-success mt-1"><i class="fas fa-check-circle fa-lg"></i></span>
          <p class="is-size-5">Licensed, insured, and locally experienced in SW Washington</p>
        </div>
        <div style="display:flex; align-items:flex-start; gap:1rem;">
          <span class="icon has-text-success mt-1"><i class="fas fa-check-circle fa-lg"></i></span>
          <p class="is-size-5">Dedicated project manager as your single point of contact</p>
        </div>
        <div style="display:flex; align-items:flex-start; gap:1rem;">
          <span class="icon has-text-success mt-1"><i class="fas fa-check-circle fa-lg"></i></span>
          <p class="is-size-5">Locked-in pricing with no surprise change orders</p>
        </div>
        <div style="display:flex; align-items:flex-start; gap:1rem;">
          <span class="icon has-text-success mt-1"><i class="fas fa-check-circle fa-lg"></i></span>
          <p class="is-size-5">Permits, footings, and inspections handled for you</p>
        </div>
      </div>
      <div class="has-text-centered mt-5">
        <a href="/deck-calculator?option=deck" class="button is-warning is-rounded"><strong>Get Your Instant Estimate</strong></a>
      </div>
    </div>
  </section>

  <!-- Built for SW Washington -->
  <section class="section has-background-warning-light">
    <div class="container has-text-centered" style="max-width:700px;">
      <h2 class="title is-3">Built for SW Washington</h2>
      <p class="is-size-5">
        SW Washington regulations, permit requirements, and climate demands are our specialty.
        We know Cowlitz County — and what it takes to build a deck right the first time.
      </p>
      <p class="mt-3">
        No vague quotes. Our itemized estimates lock in costs upfront. Change orders require
        explicit approval — no surprises.
      </p>
    </div>
  </section>

  <!-- Recent Projects -->
  <section class="section">
    <div class="container">
      <h2 class="title is-3 has-text-centered mb-5">Recent Deck Projects</h2>
      <div class="deck-photo-grid">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0405.jpg" loading="lazy" alt="Large deck with river view — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0404.jpg" loading="lazy" alt="Large Fiberon deck, Tuscan villa — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0309.jpg" loading="lazy" alt="Trex enhance naturals toasted sand with drink rail — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0204.jpg" loading="lazy" alt="Timbertech deck with cedar rails and steps — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0263.jpg" loading="lazy" alt="Deck with steps, cedar rails and cedar trim — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0313.jpg" loading="lazy" alt="Commercial deck with 42 inch aluminum rails — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0503.jpg" loading="lazy" alt="Large deck with Fiberon and steel cinch rail — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0339.jpg" loading="lazy" alt="Deck with custom ramp and aluminum rails — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0525.jpg" loading="lazy" alt="Drink rail with lights, cedar with aluminum balusters — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0391.jpg" loading="lazy" alt="Deck with cladding, aluminum rail, and cable — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0099.png" loading="lazy" alt="Deck with stainless steel cable rail — Kalama, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0126.jpeg" loading="lazy" alt="Two level Trex deck with aluminum rails — La Center, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0112.jpg" loading="lazy" alt="Timbertech deck with aluminum rails and arbor — Battle Ground, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0109.jpg" loading="lazy" alt="Custom deck with wrap around stairs — Vancouver, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0174.jpg" loading="lazy" alt="Custom cedar deck around hot tub — Camas, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0247.jpg" loading="lazy" alt="Custom cedar privacy screen on deck — La Center, WA">
      </div>
    </div>
  </section>

  <style>
  .deck-photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }
  .deck-photo-grid img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 6px;
    display: block;
  }
  </style>

  <!-- Final CTA -->
  <section class="section" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://storage.googleapis.com/columbiaoutdoor-images/photos-0309.jpg') center/cover no-repeat; padding: 4rem 1.5rem;">
    <div class="container has-text-centered">
      <h2 class="title is-2 has-text-white">Ready to Build Your Deck?</h2>
      <p class="subtitle has-text-white mt-3">
        Get an itemized estimate with no obligation. Our project manager will walk you through
        material options, rail styles, and timeline for your Woodland deck project.
      </p>
      <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;">
        <a href="/deck-calculator?option=deck" class="button is-warning is-large is-rounded mt-4"><strong>Build Your Own Deck Estimate</strong></a>
        <a href="/contact" class="button is-light is-large is-rounded mt-4">Talk to a Professional</a>
      </div>
    </div>
  </section>

  {{template "footer.gohtml" .}}
{{end}}
