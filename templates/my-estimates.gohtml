{{define "my-estimates.gohtml"}}
  {{template "header.gohtml" .Header}}

  {{with .Header}}{{if and (eq .Role "contractor") .CompanyName}}
  <div class="notification is-warning is-light mb-3">
    <span class="tag is-warning mr-2">Contractor</span> {{.CompanyName}}
  </div>
  {{end}}{{end}}

  <div class="table-container">
    {{if .Page}}
    <table class="table is-striped is-hoverable is-fullwidth">
      <thead>
        <tr>
          <th>ID</th>
          <th>Customer</th>
          <th>City</th>
          <th>Total Cost</th>
          <th>Saved</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{range .Page}}
        <tr>
          <td><a href="/estimate/{{.EstimateID}}">{{.EstimateID}}</a></td>
          <td>{{.FirstName}} {{.LastName}}</td>
          <td>{{.City}}</td>
          <td>{{formatCost .TotalCost}}</td>
          <td>{{.SaveDate.Format "2006-01-02"}}</td>
          <td><span class="tag {{if eq .Status "Accepted"}}is-success{{else if eq .Status "Expired"}}is-danger{{else}}is-light has-text-black{{end}}">{{.Status}}</span></td>
          <td>
            {{if eq .Status "Expired"}}
            <form method="post" action="/estimate/delete/{{.EstimateID}}" onsubmit="return confirm('Delete estimate {{.EstimateID}}? This cannot be undone.')">
              <input type="hidden" name="redirect" value="/my-estimates">
              <button class="button is-danger is-small is-light" type="submit" title="Delete expired estimate">
                <span class="icon"><i class="fas fa-trash"></i></span>
              </button>
            </form>
            {{end}}
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
    {{else}}
    <div class="notification is-info is-light mt-4">
      You have no saved estimates yet. <a href="/calc?option=deck">Start a new estimate.</a>
    </div>
    {{end}}
  </div>

  {{template "footer.gohtml" .}}
{{end}}
