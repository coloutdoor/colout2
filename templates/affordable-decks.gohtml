{{define "affordable-decks.gohtml"}}
  {{template "header.gohtml" .Header}}

  {{with .Page}}
  <!-- Promo banner — driven by currentAffordablePromo in citiesSEO.go and
       hidden automatically once the promo ends. -->
  {{if .PromoActive}}
  <section class="section ad-promo">
    <div class="container has-text-centered" style="max-width:820px;">
      <p class="is-uppercase has-text-weight-bold has-text-warning mb-2" style="letter-spacing:.1em;">Through {{.Promo.EndLabel}} with code {{.Promo.Code}}</p>
      <h1 class="title is-2 has-text-white mb-5">{{.Promo.Title}}</h1>
      <div class="ad-prices">
        <div class="ad-price" style="animation-delay:.05s">
          <span class="ad-ribbon">Save {{.SavePct}}%</span>
          <p class="ad-price-label">Outdoor Wood</p>
          <p class="ad-was">${{.WoodReg}}</p>
          <p class="ad-price-num">${{.Promo.Wood}}</p>
          <p class="ad-price-unit">per sq ft</p>
        </div>
        <div class="ad-price ad-price-featured" style="animation-delay:.2s">
          <span class="ad-ribbon">Save {{.SavePct}}%</span>
          <span class="ad-popular">Most Popular</span>
          <p class="ad-price-label">Cedar</p>
          <p class="ad-was">${{.CedarReg}}</p>
          <p class="ad-price-num">${{.Promo.Cedar}}</p>
          <p class="ad-price-unit">per sq ft</p>
        </div>
        <div class="ad-price" style="animation-delay:.35s">
          <span class="ad-ribbon">Save {{.SavePct}}%</span>
          <p class="ad-price-label">Composite</p>
          <p class="ad-was">${{.CompReg}}</p>
          <p class="ad-price-num"><span class="ad-from">from</span> ${{.Promo.Comp}}</p>
          <p class="ad-price-unit">per sq ft</p>
        </div>
      </div>
      {{if .Example100}}
      <div class="ad-example">
        <img src="/images/promo-100sf.jpg" width="1248" height="832" alt="Family grilling and playing on a simple ground-level Outdoor Wood deck">
        <div class="ad-example-callout">
          <p class="ad-example-size">100 sq ft Outdoor Wood deck</p>
          <p class="ad-example-price">${{.Example100}}</p>
          <p class="ad-example-note">Complete &mdash; with code {{.Promo.Code}}, plus tax</p>
        </div>
        <span class="ad-example-credit">Example image</span>
      </div>
      {{end}}
      <p class="has-text-white mt-5">
        Enter <strong class="has-text-warning">{{.Promo.Code}}</strong> in our online calculator or mention it when you contact us.
      </p>
      <div class="ad-cta">
        <a href="{{$.Page.ContactURL}}" class="button is-light is-medium is-rounded">Contact Us</a>
        <a href="/deck-calculator" class="button is-warning is-medium is-rounded"><strong>Price My Deck</strong></a>
      </div>
      <p class="ad-fine">
        Complete deck: all materials, labor, footings, framing, decking, and clean-up. Not included: sales tax,
        permits &amp; engineering, demolition/removal, fascia, rails &amp; stairs, paint or stain. Prices are for decks up to
        4 feet above the ground; decks above 4 feet high are priced separately. Offer valid on estimates created by
        {{.Promo.EndLabel}}.
      </p>
    </div>
  </section>
  {{else}}
  <section class="section ad-promo">
    <div class="container has-text-centered" style="max-width:820px;">
      <h1 class="title is-2 has-text-white mb-4">Affordable Decks in Clark County</h1>
      <p class="subtitle has-text-white">Complete Outdoor Wood, cedar, and composite decks at honest, upfront prices.</p>
      <div class="ad-cta">
        <a href="{{$.Page.ContactURL}}" class="button is-light is-medium is-rounded">Contact Us</a>
        <a href="/deck-calculator" class="button is-warning is-medium is-rounded"><strong>Price My Deck</strong></a>
      </div>
    </div>
  </section>
  {{end}}
  {{end}}

  <!-- What's included -->
  <section class="section">
    <div class="container" style="max-width:780px;">
      <h2 class="title is-3 has-text-centered mb-5">A Complete Deck, One Price</h2>
      <div class="columns">
        <div class="column">
          <p class="has-text-weight-bold mb-3">Included</p>
          <ul class="ad-list">
            <li><span class="icon has-text-success"><i class="fas fa-check"></i></span> All materials</li>
            <li><span class="icon has-text-success"><i class="fas fa-check"></i></span> Labor</li>
            <li><span class="icon has-text-success"><i class="fas fa-check"></i></span> Footings</li>
            <li><span class="icon has-text-success"><i class="fas fa-check"></i></span> Framing</li>
            <li><span class="icon has-text-success"><i class="fas fa-check"></i></span> Decking</li>
            <li><span class="icon has-text-success"><i class="fas fa-check"></i></span> Clean-up</li>
          </ul>
        </div>
        <div class="column">
          <p class="has-text-weight-bold mb-3">Priced separately</p>
          <ul class="ad-list">
            <li><span class="icon has-text-grey"><i class="fas fa-plus"></i></span> Sales tax</li>
            <li><span class="icon has-text-grey"><i class="fas fa-plus"></i></span> Permits &amp; engineering</li>
            <li><span class="icon has-text-grey"><i class="fas fa-plus"></i></span> Removing an old deck</li>
            <li><span class="icon has-text-grey"><i class="fas fa-plus"></i></span> Fascia, rails &amp; stairs</li>
            <li><span class="icon has-text-grey"><i class="fas fa-plus"></i></span> Paint or stain</li>
            <li><span class="icon has-text-grey"><i class="fas fa-plus"></i></span> Decks above 4 feet high</li>
          </ul>
        </div>
      </div>
      <p class="has-text-grey has-text-centered mt-3">Our online calculator shows every one of these as its own line item &mdash; no surprises.</p>
    </div>
  </section>

  <!-- Why decks cost so much -->
  <section class="section has-background-light">
    <div class="container" style="max-width:780px;">
      <h2 class="title is-3 has-text-dark has-text-centered mb-5">Why Do Decks Cost So Much?</h2>
      <div class="ad-why">
        <div class="ad-why-item"><span class="icon has-text-warning-dark"><i class="fas fa-layer-group fa-lg"></i></span><div><strong>Material</strong><p>Premium composite and PVC cost 2&ndash;3&times; more than wood.</p></div></div>
        <div class="ad-why-item"><span class="icon has-text-warning-dark"><i class="fas fa-arrows-alt-v fa-lg"></i></span><div><strong>Height</strong><p>Taller decks need bigger posts, bracing, and rails.</p></div></div>
        <div class="ad-why-item"><span class="icon has-text-warning-dark"><i class="fas fa-draw-polygon fa-lg"></i></span><div><strong>Shape</strong><p>Angles, curves, and levels add labor and waste.</p></div></div>
        <div class="ad-why-item"><span class="icon has-text-warning-dark"><i class="fas fa-plus-circle fa-lg"></i></span><div><strong>Extras</strong><p>Stairs, rails, lighting, and built-ins add up fast.</p></div></div>
        <div class="ad-why-item"><span class="icon has-text-warning-dark"><i class="fas fa-border-style fa-lg"></i></span><div><strong>Finishes</strong><p>Fascia, plugs, and picture framing add substantial cost with little benefit.</p></div></div>
      </div>
      <p class="has-text-dark has-text-centered has-text-weight-semibold mt-5">You don't need a magazine deck to get a great one.</p>
    </div>
  </section>

  <!-- Ways to cut cost -->
  <section class="section">
    <div class="container" style="max-width:780px;">
      <h2 class="title is-3 has-text-centered mb-5">6 Ways to Cut Your Deck Cost</h2>
      <div class="ad-tips">
        <div class="ad-tip"><span class="ad-tip-num">1</span><div><strong>Choose Outdoor Wood.</strong> It's pre-treated and doesn't need to be stained &mdash; you save on the build and on upkeep every year after.</div></div>
        <div class="ad-tip"><span class="ad-tip-num">2</span><div><strong>Skip premium composite.</strong> Wood or 25-year composite looks great and costs a fraction as much.</div></div>
        <div class="ad-tip"><span class="ad-tip-num">3</span><div><strong>Keep it simple.</strong> A rectangle is the most affordable shape to build.</div></div>
        <div class="ad-tip"><span class="ad-tip-num">4</span><div><strong>Stay low.</strong> Decks under 30 inches high usually don't require rails.</div></div>
        <div class="ad-tip"><span class="ad-tip-num">5</span><div><strong>Build in the off-season.</strong> Fall and winter scheduling is easier &mdash; and that's when we run promotions like this one.</div></div>
        <div class="ad-tip"><span class="ad-tip-num">6</span><div><strong>Do some of it yourself.</strong> Our <em>Plans + Materials</em> option gives you engineered plans, permits, and a materials list &mdash; you build it.</div></div>
      </div>
      <div class="has-text-centered mt-5">
        <a href="/deck-calculator" class="button is-warning is-medium is-rounded"><strong>Price My Deck</strong></a>
      </div>
    </div>
  </section>

  <!-- Photos -->
  <section class="section has-background-light">
    <div class="container">
      <h2 class="title is-3 has-text-dark has-text-centered mb-5">Real Cedar Decks We've Built</h2>
      <div class="ad-photo-grid">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0410.jpg" loading="lazy" alt="Cedar deck with double picture frame — Vancouver, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0174.jpg" loading="lazy" alt="Custom cedar deck around hot tub — Camas, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0134.jpg" loading="lazy" alt="Cedar deck with rails — Battle Ground, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0217.jpg" loading="lazy" alt="Cedar deck with cedar rails — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0243.jpg" loading="lazy" alt="Custom cedar deck with wrap around steps — Camas, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0173.jpg" loading="lazy" alt="Cedar deck and cedar rails — Camas, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0351.jpg" loading="lazy" alt="Upper level cedar deck and cedar rails — La Center, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0412.jpg" loading="lazy" alt="Cedar deck with glass panel rails — Vancouver, WA">
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section ad-promo" style="padding:3.5rem 1.5rem;">
    <div class="container has-text-centered">
      <h2 class="title is-3 has-text-white">See Your Price in 60 Seconds</h2>
      <p class="subtitle has-text-white mt-3">No sales visit, no callbacks &mdash; just an itemized estimate.</p>
      <div class="ad-cta">
        <a href="{{$.Page.ContactURL}}" class="button is-light is-medium is-rounded">Contact Us</a>
        <a href="/deck-calculator" class="button is-warning is-medium is-rounded"><strong>Price My Deck</strong></a>
      </div>
    </div>
  </section>

  <style>
  .ad-promo { background: #1a2530; padding: 3.5rem 1.5rem; }
  .ad-prices { display: grid; grid-template-columns: repeat(3, 1fr); gap: .9rem; align-items: end; margin-top: 1.25rem; }
  .ad-price {
    position: relative; overflow: hidden;
    background: linear-gradient(180deg, #2b3e50 0%, #1f2e3b 100%);
    border: 2px solid #3a4f63; border-radius: 14px; padding: 1.6rem .5rem 1.1rem; color: #e8edf2;
    box-shadow: 0 8px 24px rgba(0,0,0,.35);
    animation: ad-pop .6s cubic-bezier(.2,1.4,.4,1) both;
  }
  .ad-price-featured { border-color: #ffdd57; transform: scale(1.06); box-shadow: 0 0 0 3px rgba(255,221,87,.25), 0 10px 30px rgba(0,0,0,.45); }
  .ad-ribbon {
    position: absolute; top: 14px; right: -34px; width: 120px; transform: rotate(45deg);
    background: #ff3860; color: #fff; font-size: .65rem; font-weight: 800; letter-spacing: .05em;
    text-transform: uppercase; padding: 3px 0; box-shadow: 0 2px 6px rgba(0,0,0,.3);
  }
  .ad-popular {
    position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    background: #ffdd57; color: #1a2530; font-size: .65rem; font-weight: 800; text-transform: uppercase;
    letter-spacing: .06em; padding: 2px 10px; border-radius: 0 0 8px 8px; white-space: nowrap;
  }
  .ad-price-label { font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: .85rem; margin-top: .25rem; }
  .ad-was { color: #b5c0cb; text-decoration: line-through; text-decoration-color: #ff3860; text-decoration-thickness: 2px; font-size: 1rem; margin-top: .35rem; }
  .ad-price-num {
    font-size: 2.6rem; font-weight: 900; color: #ffdd57; line-height: 1.05;
    text-shadow: 0 0 18px rgba(255,221,87,.45), 0 2px 0 rgba(0,0,0,.35);
  }
  .ad-from { font-size: .9rem; font-weight: 700; color: #e8edf2; text-shadow: none; }
  .ad-price-unit { font-size: .8rem; color: #b5c0cb; margin-top: .15rem; }
  .ad-example { position: relative; margin-top: 2rem; border-radius: 14px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,.45); border: 2px solid #3a4f63; }
  .ad-example img { display: block; width: 100%; height: auto; }
  .ad-example-callout {
    position: absolute; left: 1rem; bottom: 1rem; text-align: left;
    background: rgba(26,37,48,.88); border: 2px solid #ffdd57; border-radius: 12px;
    padding: .8rem 1.1rem; box-shadow: 0 6px 18px rgba(0,0,0,.4);
  }
  .ad-example-size { color: #e8edf2; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; font-size: .8rem; }
  .ad-example-price { color: #ffdd57; font-weight: 900; font-size: 2.6rem; line-height: 1.05; text-shadow: 0 0 18px rgba(255,221,87,.45); }
  .ad-example-note { color: #b5c0cb; font-size: .78rem; }
  .ad-example-credit { position: absolute; right: .6rem; bottom: .4rem; font-size: .65rem; color: rgba(255,255,255,.75); text-shadow: 0 1px 2px rgba(0,0,0,.8); }
  @keyframes ad-pop { from { opacity: 0; transform: translateY(14px) scale(.92); } }
  .ad-price-featured { animation-name: ad-pop-featured; }
  @keyframes ad-pop-featured { from { opacity: 0; transform: translateY(14px) scale(.92); } to { transform: scale(1.06); } }
  @media (prefers-reduced-motion: reduce) { .ad-price { animation: none; } }
  .ad-cta { display: flex; gap: .75rem; justify-content: center; flex-wrap: wrap; margin-top: 1.5rem; }
  .ad-fine { font-size: .75rem; color: #b5c0cb; margin-top: 1.5rem; max-width: 640px; margin-left: auto; margin-right: auto; }
  .ad-list { list-style: none; margin: 0; }
  .ad-list li { display: flex; align-items: center; gap: .5rem; padding: .25rem 0; }
  .ad-why { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
  .ad-why-item { display: flex; gap: .75rem; align-items: flex-start; background: #fff; border-radius: 10px; padding: .9rem 1rem; box-shadow: 0 2px 8px rgba(0,0,0,.06); color: #363636; }
  .ad-why-item strong { color: #1a2530; }
  .ad-why-item p { font-size: .92rem; color: #4a4a4a; margin-top: .1rem; }
  .ad-tips { display: flex; flex-direction: column; gap: 1rem; }
  .ad-tip { display: flex; gap: 1rem; align-items: flex-start; font-size: 1.05rem; }
  .ad-tip-num { flex: 0 0 2rem; height: 2rem; border-radius: 50%; background: #ffdd57; color: #1a2530; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .ad-photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
  .ad-photo-grid img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 6px; display: block; }
  @media (max-width: 480px) {
    .ad-prices { gap: .5rem; }
    .ad-price { padding: 1.5rem .25rem .9rem; border-radius: 10px; }
    .ad-price-num { font-size: 1.6rem; }
    .ad-price-label { font-size: .7rem; letter-spacing: .03em; }
    .ad-was { font-size: .8rem; }
    .ad-from { display: block; }
    .ad-ribbon { font-size: .55rem; right: -38px; top: 10px; }
    .ad-example-callout { left: .5rem; bottom: .5rem; padding: .5rem .7rem; }
    .ad-example-size { font-size: .65rem; }
    .ad-example-price { font-size: 1.7rem; }
    .ad-example-note { font-size: .65rem; }
  }
  </style>

  {{template "footer.gohtml" .}}
{{end}}
