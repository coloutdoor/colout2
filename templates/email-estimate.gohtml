{{define "email-estimate.gohtml"}}<!DOCTYPE html>
<html lang="en-us">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Deck Estimate #{{.Estimate.EstimateID}} — Columbia Outdoor</title>
<style>
  body{margin:0;padding:0;background:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#1a2535;}
  a{color:#2c6e9e;}
  @media only screen and (max-width:600px){
    .email-wrap{width:100%!important;}
    .col-half{display:block!important;width:100%!important;padding-right:0!important;}
  }
</style>
</head>
<body style="margin:0;padding:0;background:#f4f6f8;">
<table width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f6f8;">
<tr><td align="center" style="padding:24px 12px;">

  <table class="email-wrap" width="620" cellpadding="0" cellspacing="0" border="0" style="max-width:620px;background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.1);">

    <!-- ── Blue header banner ── -->
    <tr>
      <td style="background:#2c6e9e;padding:24px 28px;">
        <div style="font-size:20px;font-weight:700;color:#fff;margin-bottom:2px;">Columbia Outdoor</div>
        <div style="font-size:13px;color:rgba(255,255,255,.75);">SW Washington's Trusted Outdoor Living Platform</div>
      </td>
    </tr>

    <!-- ── Estimate meta strip ── -->
    <tr>
      <td style="background:#f0f5fa;padding:12px 28px;border-left:4px solid #2c6e9e;">
        <strong style="font-size:14px;">Estimate #{{.Estimate.EstimateID}}{{if .Estimate.Version}}-{{.Estimate.Version}}{{end}}</strong>
        {{if .Estimate.Desc}} &mdash; {{.Estimate.Desc}}{{end}}<br>
        <span style="color:#64748b;font-size:12px;">
          Prepared: {{.Estimate.SaveDate.Format "January 2, 2006"}}
          &nbsp;&middot;&nbsp;
          {{if not .Estimate.ExpirationDate.IsZero}}Valid through: {{.Estimate.ExpirationDate.Format "January 2, 2006"}}{{end}}
        </span>
      </td>
    </tr>

    <!-- ── Intro ── -->
    <tr>
      <td style="padding:24px 28px 8px;">
        <p style="margin:0 0 12px;">Hi {{.Estimate.Customer.FirstName}},</p>
        <p style="margin:0 0 12px;"><strong>{{.ContractorName}}</strong> has prepared a detailed outdoor living estimate for your project.</p>
        <p style="margin:0 0 20px;">You can review and accept this estimate directly through Columbia Outdoor's platform. Once accepted, Columbia Outdoor will coordinate scheduling, ensure the project stays on track, and support you through to completion.</p>
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td align="center" style="padding:4px 0 20px;">
              <a href="{{.EstimateURL}}" style="display:inline-block;background:#2c6e9e;color:#fff;padding:13px 32px;border-radius:5px;text-decoration:none;font-weight:700;font-size:15px;">
                Review &amp; Accept Estimate Online
              </a>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- ── Divider ── -->
    <tr>
      <td style="padding:0 28px;">
        <hr style="border:none;border-top:2px solid #1a2535;margin:0 0 20px;">
      </td>
    </tr>

    <!-- ── Parties ── -->
    <tr>
      <td style="padding:0 28px 20px;">
        <table width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td class="col-half" width="50%" style="vertical-align:top;padding-right:20px;">
              <div style="font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#64748b;border-bottom:1px solid #e2e8f0;padding-bottom:4px;margin-bottom:8px;">From</div>
              <div style="font-size:13px;font-weight:600;margin-bottom:3px;">{{.ContractorName}}</div>
              <div style="font-size:12px;color:#4a6075;line-height:1.7;">
                {{.ContractorPhone}}<br>
                {{.ContractorWebsite}}
                {{if .ContractorLicense}}<br>License: {{.ContractorLicense}}{{end}}
              </div>
            </td>
            <td class="col-half" width="50%" style="vertical-align:top;">
              <div style="font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#64748b;border-bottom:1px solid #e2e8f0;padding-bottom:4px;margin-bottom:8px;">Prepared For</div>
              <div style="font-size:13px;font-weight:600;margin-bottom:3px;">{{.Estimate.Customer.FirstName}} {{.Estimate.Customer.LastName}}</div>
              <div style="font-size:12px;color:#4a6075;line-height:1.7;">
                {{if .Estimate.Customer.Address}}{{.Estimate.Customer.Address}}<br>{{end}}
                {{if or .Estimate.Customer.City .Estimate.Customer.State}}{{.Estimate.Customer.City}}{{if and .Estimate.Customer.City .Estimate.Customer.State}}, {{end}}{{.Estimate.Customer.State}} {{.Estimate.Customer.Zip}}<br>{{end}}
                {{if .Estimate.Customer.PhoneNumber}}{{.Estimate.Customer.PhoneNumber}}<br>{{end}}
                {{if .Estimate.Customer.Email}}{{.Estimate.Customer.Email}}{{end}}
              </div>
            </td>
          </tr>
        </table>
      </td>
    </tr>

    <!-- ── Scope of work ── -->
    <tr>
      <td style="padding:0 28px 8px;">
        <div style="font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#64748b;margin-bottom:10px;">
          Scope of Work
          &nbsp;
          <span style="font-size:8px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:2px 6px;border-radius:3px;{{if eq .Estimate.DIYMode 1}}background:#fff3cd;color:#856404;{{else if eq .Estimate.DIYMode 2}}background:#e2e8f0;color:#475569;{{else}}background:#d4edda;color:#1a5c32;{{end}}">
            {{if eq .Estimate.DIYMode 1}}Plans + Materials{{else if eq .Estimate.DIYMode 2}}Plans Only{{else}}Full Service{{end}}
          </span>
        </div>
        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;font-size:12px;">
          <thead>
            <tr style="background:#f8fafc;">
              <th style="padding:7px 8px;text-align:left;font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:#64748b;border-bottom:1px solid #cbd5e1;width:110px;">Item</th>
              <th style="padding:7px 8px;text-align:left;font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:#64748b;border-bottom:1px solid #cbd5e1;">Description</th>
              <th style="padding:7px 8px;text-align:right;font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:#64748b;border-bottom:1px solid #cbd5e1;width:90px;">Cost</th>
            </tr>
          </thead>
          <tbody>
            {{if .Estimate.HasDemo}}
            <tr>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;font-weight:600;color:#1a2535;vertical-align:top;">Demo</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;color:#4a6075;vertical-align:top;">{{formatDemoDescription .Estimate}}</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;text-align:right;white-space:nowrap;font-family:'Courier New',monospace;">{{formatCost .Estimate.DemoCost}}</td>
            </tr>
            {{end}}
            <tr>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;font-weight:600;color:#1a2535;vertical-align:top;">Deck</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;color:#4a6075;vertical-align:top;">{{formatDeckDescription .Estimate}}</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;text-align:right;white-space:nowrap;font-family:'Courier New',monospace;">{{formatCost .Estimate.DeckCost}}</td>
            </tr>
            {{if .Estimate.RailMaterial}}
            <tr>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;font-weight:600;color:#1a2535;vertical-align:top;">Rail</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;color:#4a6075;vertical-align:top;">{{formatRailDescription .Estimate}}</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;text-align:right;white-space:nowrap;font-family:'Courier New',monospace;">{{formatCost .Estimate.RailCost}}</td>
            </tr>
            {{end}}
            {{if .Estimate.HasFascia}}
            <tr>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;font-weight:600;color:#1a2535;vertical-align:top;">Fascia</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;color:#4a6075;vertical-align:top;">{{formatFasciaDescription .Estimate}}</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;text-align:right;white-space:nowrap;font-family:'Courier New',monospace;">{{formatCost .Estimate.FasciaCost}}</td>
            </tr>
            {{end}}
            {{if gt .Estimate.StairWidth 0.0}}
            <tr>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;font-weight:600;color:#1a2535;vertical-align:top;">Stairs</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;color:#4a6075;vertical-align:top;">{{formatStairDescription .Estimate}}</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;text-align:right;white-space:nowrap;font-family:'Courier New',monospace;">{{formatCost .Estimate.StairCost}}</td>
            </tr>
            {{if gt .Estimate.StairRailCount 0.0}}
            <tr>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;font-weight:600;color:#1a2535;vertical-align:top;">Stair Rails</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;color:#4a6075;vertical-align:top;">{{formatStairRailDescription .Estimate}}</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;text-align:right;white-space:nowrap;font-family:'Courier New',monospace;">{{formatCost .Estimate.StairRailCost}}</td>
            </tr>
            {{end}}
            {{if .Estimate.HasStairFascia}}
            <tr>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;font-weight:600;color:#1a2535;vertical-align:top;">Stair Fascia</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;color:#4a6075;vertical-align:top;">{{formatStairFasciaDescription .Estimate}}</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;text-align:right;white-space:nowrap;font-family:'Courier New',monospace;">{{formatCost .Estimate.StairFasciaCost}}</td>
            </tr>
            {{end}}
            {{if .Estimate.HasStairTK}}
            <tr>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;font-weight:600;color:#1a2535;vertical-align:top;">Stair Toe Kicks</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;color:#4a6075;vertical-align:top;">{{formatStairTKDescription .Estimate}}</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;text-align:right;white-space:nowrap;font-family:'Courier New',monospace;">{{formatCost .Estimate.StairToeKickCost}}</td>
            </tr>
            {{end}}
            {{end}}
            {{if .Estimate.PermitCost}}
            <tr>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;font-weight:600;color:#1a2535;vertical-align:top;">Design &amp; Permits</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;color:#4a6075;vertical-align:top;">{{formatPermitDescription .Estimate}}</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;text-align:right;white-space:nowrap;font-family:'Courier New',monospace;">{{formatCost .Estimate.PermitCost}}</td>
            </tr>
            {{end}}
            {{range .Estimate.CustomItems}}
            {{if or .Description .Cost}}
            <tr>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;font-weight:600;color:#1a2535;vertical-align:top;">{{.Description}}</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;color:#4a6075;vertical-align:top;">{{.Notes}}</td>
              <td style="padding:7px 8px;border-bottom:1px solid #f1f5f9;text-align:right;white-space:nowrap;font-family:'Courier New',monospace;{{if lt .Cost 0.0}}color:#1a5c32;{{end}}">
                {{if lt .Cost 0.0}}-{{formatCost (neg .Cost)}}{{else}}{{formatCost .Cost}}{{end}}
              </td>
            </tr>
            {{end}}
            {{end}}
          </tbody>
          <tfoot>
            <tr>
              <td colspan="2" style="padding:7px 8px;text-align:right;border-top:1px solid #cbd5e1;font-weight:600;color:#1a2535;">Subtotal</td>
              <td style="padding:7px 8px;text-align:right;border-top:1px solid #cbd5e1;font-family:'Courier New',monospace;">{{formatCost .Estimate.Subtotal}}</td>
            </tr>
            {{if gt .Estimate.DiscountAmount 0.0}}
            <tr>
              <td colspan="2" style="padding:7px 8px;text-align:right;color:#1a5c32;">Discount{{if .Estimate.DiscountCode}} ({{.Estimate.DiscountCode}}){{end}}</td>
              <td style="padding:7px 8px;text-align:right;color:#1a5c32;font-family:'Courier New',monospace;">-{{formatCost .Estimate.DiscountAmount}}</td>
            </tr>
            {{end}}
            <tr>
              <td colspan="2" style="padding:7px 8px;text-align:right;color:#64748b;">
                {{if .Estimate.Customer.State}}{{.Estimate.Customer.State}}{{else}}WA{{end}} Sales Tax (estimated)
              </td>
              <td style="padding:7px 8px;text-align:right;color:#64748b;font-family:'Courier New',monospace;">{{formatCost .Estimate.SalesTax}}</td>
            </tr>
            <tr style="background:#1a2535;">
              <td colspan="2" style="padding:12px 8px;text-align:right;font-weight:700;font-size:14px;color:#fff;">Total</td>
              <td style="padding:12px 8px;text-align:right;font-weight:700;font-size:16px;color:#4aaa7a;font-family:'Courier New',monospace;">{{formatCost .Estimate.TotalCost}}</td>
            </tr>
          </tfoot>
        </table>
      </td>
    </tr>

    <!-- ── Footer ── -->
    <tr>
      <td style="padding:20px 28px;background:#f8fafc;border-top:1px solid #e2e8f0;">
        <p style="margin:0 0 6px;font-size:12px;color:#64748b;">
          This estimate is valid{{if not .Estimate.ExpirationDate.IsZero}} through <strong>{{.Estimate.ExpirationDate.Format "January 2, 2006"}}</strong>{{end}}.
          To accept online, use the button above. For questions, contact us at
          <a href="mailto:support@columbiaoutdoor.com" style="color:#2c6e9e;">support@columbiaoutdoor.com</a>
          or (360) 787-8062.
        </p>
        <p style="margin:0;font-size:11px;color:#94a3b8;">Columbia Outdoor &middot; columbiaoutdoor.com &middot; SW Washington</p>
      </td>
    </tr>

  </table>

</td></tr>
</table>
</body>
</html>{{end}}
