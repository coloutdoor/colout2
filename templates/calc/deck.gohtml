{{define "deck.gohtml"}}
  {{template "header.gohtml" .Header}}
  {{template "deckheader.gohtml" .}}

  <div style="max-width:480px;">
    <h2 class="title is-4 mt-4">How Much Does a Deck Cost in SW Washington?</h2>
    <p class="has-text-grey mb-4">Deck costs in SW Washington typically range from <strong>$8,000 to $45,000+</strong> depending on size, materials, height, and complexity. Use this calculator to get an instant itemized estimate — no callbacks, no salesperson.</p>
  </div>

  {{with .Page}}
    <div class="notification is-info is-light mb-4" style="max-width:480px;">
      Enter your <strong>main deck</strong> dimensions below. You can add additional sections (bump-outs, wraparounds) on the estimate page.
    </div>
    <form method="post" action="/estimate" class="box" style="max-width: 480px;">

        <div class="field">
            <label class="label">Project Type</label>
            <div class="buttons has-addons mb-1">
              <button type="button" id="mode-btn-0" onclick="setMode(0)"
                class="button{{if eq .DIYMode 0}} is-link is-selected{{end}}">
                <span class="icon is-small"><i class="fas fa-hard-hat"></i></span>
                <span>Full Service</span>
              </button>
              <button type="button" id="mode-btn-1" onclick="setMode(1)"
                class="button{{if eq .DIYMode 1}} is-success is-selected{{end}}">
                <span class="icon is-small"><i class="fas fa-tools"></i></span>
                <span>Plans + Materials</span>
              </button>
              <button type="button" id="mode-btn-2" onclick="setMode(2)"
                class="button{{if eq .DIYMode 2}} is-warning is-selected{{end}}">
                <span class="icon is-small"><i class="fas fa-drafting-compass"></i></span>
                <span>Plans Only</span>
              </button>
            </div>
            <p id="mode-help" class="help">
              {{if eq .DIYMode 1}}Design, engineering, permits, and materials list — you install.
              {{- else if eq .DIYMode 2}}Professional design, engineering, and permit package only — no materials.
              {{- else}}Columbia Outdoor builds your project from estimate to final walkthrough.{{end}}
            </p>
            <input type="hidden" name="diyMode" id="diy-mode-hidden" value="{{.DIYMode}}">
        </div>

        <div class="field">
            <label class="label">Project Description</label>
            <div class="control">
                <input class="input" type="text" name="desc" value="{{printf "%s" .Desc}}" maxlength="50" placeholder="e.g. Back yard deck, master bedroom deck...">
            </div>
        </div>

        <div class="field">
            <label class="label">Projection (ft)</label>
            <div class="control">
                <input class="input" type="number" name="length" step="0.1" min="1" value="{{if .Length}}{{printf "%.1f" .Length}}{{end}}" required placeholder="e.g. 20">
            </div>
        </div>

        <div class="field">
            <label class="label">Width (ft)</label>
            <div class="control">
                <input class="input" type="number" name="width" step="0.1" min="1" value="{{if .Width}}{{printf "%.1f" .Width}}{{end}}" required placeholder="e.g. 16">
            </div>
        </div>

        <div class="field">
            <label class="label">Height above grade (ft)</label>
            <div class="control">
                <input class="input" type="number" name="height" step="0.1" min="0" value="{{if .Height}}{{printf "%.1f" .Height}}{{end}}" required placeholder="e.g. 3">
            </div>
        </div>

        <div class="field">
            <label class="label">
                Finish Level
                <a href="#" class="ml-2" onclick="document.getElementById('finish-modal').classList.add('is-active'); return false;">
                    <span class="icon"><i class="fas fa-question-circle has-text-info"></i></span>
                </a>
            </label>
            <div class="control">
                <div class="select is-fullwidth">
                    <select name="finish" required>
                        <option value="1" {{if eq .Material "outdoorWood"}}selected{{end}}>Economy — Pressure Treated $</option>
                        <option value="2" {{if eq .Material "cedar"}}selected{{end}}>Standard — Cedar $$</option>
                        <option value="3" {{if eq .Material "timberTechPrime"}}selected{{end}}>Enhanced — Composite $$$</option>
                        <option value="4" {{if eq .Material "timberTechProReserve"}}selected{{end}}>Premium — Composite Reserve $$$$</option>
                        <option value="5" {{if eq .Material "timberTechProLegacy"}}selected{{end}}>Premier — Composite Legacy $$$$$</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="field">
            <label class="checkbox">
                <input type="checkbox" name="hasStairs" {{if .StairWidth}}checked{{end}}>
                Include stairs
            </label>
        </div>

        <div class="field">
            <label class="checkbox">
                <input type="checkbox" name="hasDemo" {{if .HasDemo}}checked{{end}}>
                Demo and dispose of existing deck
            </label>
        </div>

                        <!-- Modal Help Dialog-->
                        <div id="finish-modal" class="modal">
                            <div class="modal-background" onclick="this.parentElement.classList.remove('is-active')"></div>
                            <div class="modal-card">
                                <header class="modal-card-head"><p class="modal-card-title">Finish Level Guide - You can customize this later</p></header>
                                <section class="modal-card-body">
                                    <table class="table is-fullwidth is-striped is-hoverable">
                                        <thead>
                                            <tr>
                                                <th>Finish Level</th>
                                                <th>Deck</th>
                                                <th>Rails</th>
                                                <th>Fascia</th>
                                                <th>Infill</th>
                                                <th>Joists</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="has-text-weight-bold">Economy</td>
                                                <td>Pressure-treated lumber</td>
                                                <td>Outdoor Wood</td>
                                                <td>Optional</td>
                                                <td>Outdoor Wood</td>
                                                <td>24" oc</td>
                                            </tr>
                                            <tr>
                                                <td class="has-text-weight-bold">Standard</td>
                                                <td>Western red cedar</td>
                                                <td>Cedar</td>
                                                <td>Optional</td>
                                                <td>Cedar</td>
                                                <td>24" oc</td>
                                            </tr>
                                            <tr>
                                                <td class="has-text-weight-bold">Enhanced</td>
                                                <td>TimberTech Prime+ composite</td>
                                                <td>Aluminum</td>
                                                <td>Optional</td>
                                                <td>Aluminum balusters</td>
                                                <td>16" oc</td>
                                            </tr>
                                            <tr>
                                                <td class="has-text-weight-bold">Premium</td>
                                                <td>TimberTech Pro Reserve</td>
                                                <td>Aluminum</td>
                                                <td>Included</td>
                                                <td>Stainless cable</td>
                                                <td>12" oc</td>
                                            </tr>
                                            <tr>
                                                <td class="has-text-weight-bold">Premier</td>
                                                <td>TimberTech Pro Legacy</td>
                                                <td>Composite</td>
                                                <td>Included</td>
                                                <td>Glass</td>
                                                <td>Metal frame</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    </section>
                                <footer class="modal-card-foot">
                                    <button class="button" type="button" onclick="document.getElementById('finish-modal').classList.remove('is-active')">Close</button>
                                </footer>
                            </div>
                        </div>
                    </div>
                </div>
        <div class="field mt-5">
            <div class="control">
                <input id="submit-btn" class="button is-primary is-fullwidth is-medium" type="submit"
                  value="{{if eq .DIYMode 1}}Get Plans + Materials Estimate{{else if eq .DIYMode 2}}Get Plans Only Estimate{{else}}Get Estimate{{end}}">
            </div>
        </div>

    </form>

    <div style="max-width:480px; margin-top:2rem;">
      <h2 class="title is-4">How It Works</h2>
      <div class="columns is-mobile mt-2">
        <div class="column has-text-centered">
          <span class="icon is-large has-text-link"><i class="fas fa-ruler-combined fa-2x"></i></span>
          <p class="has-text-weight-bold mt-2">1. Enter Dimensions</p>
          <p class="has-text-grey is-size-7">Projection, width, height, and materials. Takes about 60 seconds.</p>
        </div>
        <div class="column has-text-centered">
          <span class="icon is-large has-text-link"><i class="fas fa-dollar-sign fa-2x"></i></span>
          <p class="has-text-weight-bold mt-2">2. Get Instant Estimate</p>
          <p class="has-text-grey is-size-7">See a full itemized cost breakdown — deck, rails, stairs, permits, and more.</p>
        </div>
        <div class="column has-text-centered">
          <span class="icon is-large has-text-link"><i class="fas fa-share-alt fa-2x"></i></span>
          <p class="has-text-weight-bold mt-2">3. Save or Share</p>
          <p class="has-text-grey is-size-7">Save your estimate, email it to yourself, or share it with a contractor.</p>
        </div>
      </div>
    </div>

    <script>
    const modeHelp = [
      'Columbia Outdoor builds your project from estimate to final walkthrough.',
      'Design, engineering, permits, and materials list — you install.',
      'Professional design, engineering, and permit package only — no materials.'
    ];
    const modeColors = ['is-link', 'is-success', 'is-warning'];
    const modeSubmit = ['Get Estimate', 'Get Plans + Materials Estimate', 'Get Plans Only Estimate'];

    function setMode(mode) {
      document.getElementById('diy-mode-hidden').value = mode;
      document.getElementById('mode-help').textContent = modeHelp[mode];
      document.getElementById('submit-btn').value = modeSubmit[mode];
      [0, 1, 2].forEach(m => {
        const btn = document.getElementById('mode-btn-' + m);
        btn.className = 'button' + (m === mode ? ' ' + modeColors[m] + ' is-selected' : '');
      });
    }
    </script>
    {{end}}
   {{template "footer.gohtml" .}}
{{end}}
