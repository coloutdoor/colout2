{{define "deck.gohtml"}}
  {{template "header.gohtml" .Header}}
  {{template "deckheader.gohtml" .}}

  {{with .Page}}
    <form method="post" action="/estimate" class="box" style="max-width: 480px;">

        <div class="field">
            <label class="label">
                Deck Material
                <a href="#" class="ml-2" onclick="document.getElementById('finish-modal').classList.add('is-active'); return false;">
                    <span class="icon"><i class="fas fa-question-circle has-text-info"></i></span>
                </a>
            </label>
            <div class="control">
                <div class="select is-fullwidth">
                    <select name="finish" required>
                        <option value="1" {{if eq .Material "outdoorWood"}}selected{{end}}>Pressure Treated</option>
                        <option value="2" {{if eq .Material "cedar"}}selected{{end}}>Cedar</option>
                        <option value="3" {{if eq .Material "timberTechPrime"}}selected{{end}}>Composite (25 year)</option>
                        <option value="4" {{if eq .Material "timberTechProReserve"}}selected{{end}}>Composite (30 year)</option>
                        <option value="5" {{if or (eq .Material "timberTechAzek") (eq .Material "timberTechProLegacy")}}selected{{end}}>Cellular PVC (50 year)</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="field">
            <label class="label">Project Description</label>
            <div class="control">
                <input class="input" type="text" name="desc" value="{{printf "%s" .Desc}}" maxlength="50" placeholder="e.g. Back yard deck, master bedroom deck...">
            </div>
        </div>

        <div class="field">
            <label class="label">Depth (ft) <span class="has-text-grey-light">(out from house)</span></label>
            <div class="control">
                <input class="input" type="number" name="length" step="0.1" min="1" value="{{if .Length}}{{printf "%.1f" .Length}}{{end}}" required placeholder="e.g. 20">
            </div>
        </div>

        <div class="field">
            <label class="label">Width (ft) <span class="has-text-grey-light">(along house)</span></label>
            <div class="control">
                <input class="input" type="number" name="width" step="0.1" min="1" value="{{if .Width}}{{printf "%.1f" .Width}}{{end}}" required placeholder="e.g. 16">
            </div>
        </div>

        <div class="field">
            <label class="label">Height (ft) <span class="has-text-grey-light">(above the ground)</span></label>
            <div class="control">
                <input class="input" type="number" name="height" step="0.1" min="0" value="{{if .Height}}{{printf "%.1f" .Height}}{{end}}" required placeholder="e.g. 3">
            </div>
        </div>

        </div>

        <div class="field">
            <label class="checkbox">
                <input type="checkbox" name="hasStairs" {{if .StairWidth}}checked{{end}}>
                Include stairs
            </label>
        </div>

        <div class="field">
            <label class="checkbox">
                <input type="checkbox" name="hasDemo" {{if .HasDemo}}checked{{end}}>
                Demo and dispose of existing deck
            </label>
        </div>

                        <!-- Modal Help Dialog-->
                        <div id="finish-modal" class="modal">
                            <div class="modal-background" onclick="this.parentElement.classList.remove('is-active')"></div>
                            <div class="modal-card">
                                <header class="modal-card-head"><p class="modal-card-title">Deck Material Guide - You can customize this later</p></header>
                                <section class="modal-card-body">
                                    <table class="table is-fullwidth is-striped is-hoverable">
                                        <thead>
                                            <tr>
                                                <th>Deck Material</th>
                                                <th>Deck</th>
                                                <th>Rails</th>
                                                <th>Fascia</th>
                                                <th>Infill</th>
                                                <th>Joists</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="has-text-weight-bold">Pressure Treated</td>
                                                <td>Pressure-treated lumber</td>
                                                <td>Outdoor Wood</td>
                                                <td>Optional</td>
                                                <td>Outdoor Wood</td>
                                                <td>24" oc</td>
                                            </tr>
                                            <tr>
                                                <td class="has-text-weight-bold">Cedar</td>
                                                <td>Western red cedar</td>
                                                <td>Cedar</td>
                                                <td>Optional</td>
                                                <td>Cedar</td>
                                                <td>24" oc</td>
                                            </tr>
                                            <tr>
                                                <td class="has-text-weight-bold">Composite (25 year)</td>
                                                <td>TimberTech Prime+ composite</td>
                                                <td>Aluminum</td>
                                                <td>Optional</td>
                                                <td>Aluminum balusters</td>
                                                <td>16" oc</td>
                                            </tr>
                                            <tr>
                                                <td class="has-text-weight-bold">Composite (30 year)</td>
                                                <td>TimberTech Pro Reserve</td>
                                                <td>Aluminum</td>
                                                <td>Included</td>
                                                <td>Stainless cable</td>
                                                <td>12" oc</td>
                                            </tr>
                                            <tr>
                                                <td class="has-text-weight-bold">Cellular PVC (50 year)</td>
                                                <td>TimberTech AZEK cellular PVC</td>
                                                <td>Composite</td>
                                                <td>Included</td>
                                                <td>Glass</td>
                                                <td>Metal frame</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    </section>
                                <footer class="modal-card-foot">
                                    <button class="button" type="button" onclick="document.getElementById('finish-modal').classList.remove('is-active')">Close</button>
                                </footer>
                            </div>
                        </div>
                    </div>
                </div>
        {{/* Service tier is no longer chosen here: Full Service by default, or
             whatever a ?diyMode= link (e.g. the homepage DIY option) asked for. */}}
        <input type="hidden" name="diyMode" value="{{.DIYMode}}">

        <div class="promo-box">
            <label class="promo-label" for="promo-code">
                <i class="fas fa-tag"></i> Have a promo code?
            </label>
            <input class="promo-input" type="text" id="promo-code" name="discountCode"
              value="{{.DiscountCode}}" placeholder="e.g. DECKS26" maxlength="20"
              autocomplete="off" autocapitalize="characters" spellcheck="false"
              oninput="this.value = this.value.toUpperCase().replace(/\s+/g, '')">
            <p class="promo-help">Optional &mdash; your discount shows on the estimate.</p>
        </div>

        <div class="field mt-5">
            <div class="control">
                <input id="submit-btn" class="button is-primary is-fullwidth is-medium" type="submit"
                  value="{{if eq .DIYMode 1}}Get Plans + Materials Estimate{{else if eq .DIYMode 2}}Get Plans Only Estimate{{else}}Get Estimate{{end}}">
            </div>
        </div>

    </form>

    <form method="post" action="/calc/reset" class="has-text-centered mt-2" style="max-width:480px;"
      onsubmit="return confirm('Clear all values and start over?');">
      <input type="hidden" name="return" value="/deck-calculator">
      <button type="submit" class="button is-small is-text has-text-grey">Start over</button>
    </form>

    <div style="max-width:480px; margin-top:2rem;">
      <h2 class="title is-4">How It Works</h2>
      <div class="columns is-mobile mt-2">
        <div class="column has-text-centered">
          <span class="icon is-large has-text-link"><i class="fas fa-ruler-combined fa-2x"></i></span>
          <p class="has-text-weight-bold mt-2">1. Enter Dimensions</p>
          <p class="has-text-grey is-size-7">Depth, width, height, and materials. Takes about 60 seconds.</p>
        </div>
        <div class="column has-text-centered">
          <span class="icon is-large has-text-link"><i class="fas fa-dollar-sign fa-2x"></i></span>
          <p class="has-text-weight-bold mt-2">2. Get Instant Estimate</p>
          <p class="has-text-grey is-size-7">See a full itemized cost breakdown — deck, rails, stairs, permits, and more.</p>
        </div>
        <div class="column has-text-centered">
          <span class="icon is-large has-text-link"><i class="fas fa-share-alt fa-2x"></i></span>
          <p class="has-text-weight-bold mt-2">3. Save or Share</p>
          <p class="has-text-grey is-size-7">Save your estimate, email it to yourself, or share it with a contractor.</p>
        </div>
      </div>
    </div>

    <style>
    .promo-box {
      margin-top: 1.25rem; padding: .9rem 1rem .75rem;
      border: 2px dashed #e0b400; border-radius: 10px; background: rgba(255,221,87,.10);
    }
    .promo-label { display: block; font-weight: 700; margin-bottom: .45rem; }
    .promo-label i { color: #e0b400; margin-right: .3rem; }
    .promo-input {
      width: 100%; padding: .55rem .75rem; border-radius: 6px; border: 1px solid #c9a200;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 1.05rem;
      letter-spacing: .12em; text-transform: uppercase; background: #fff; color: #1a2530;
    }
    .promo-input::placeholder { letter-spacing: .04em; color: #9aa5b1; text-transform: none; }
    .promo-help { font-size: .75rem; color: #7a7f87; margin-top: .35rem; }
    </style>
    {{end}}
   {{template "footer.gohtml" .}}
{{end}}
