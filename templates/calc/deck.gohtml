{{define "deck.gohtml"}}
  {{template "header.gohtml" .Header}}
  {{template "deckheader.gohtml" .}}

  {{with .Page}}
    <div class="notification is-info is-light mb-4" style="max-width:480px;">
      Enter your <strong>main deck</strong> dimensions below. You can add additional sections (bump-outs, wraparounds) on the estimate page.
    </div>
    <form method="post" action="/estimate" class="box" style="max-width: 480px;">

        <div class="field">
            <label class="label">Project Description</label>
            <div class="control">
                <input class="input" type="text" name="desc" value="{{printf "%s" .Desc}}" maxlength="50" placeholder="e.g. Back yard deck, master bedroom deck...">
            </div>
        </div>

        <div class="field">
            <label class="label">Length (ft)</label>
            <div class="control">
                <input class="input" type="number" name="length" step="0.1" min="1" value="{{if .Length}}{{printf "%.1f" .Length}}{{end}}" required placeholder="e.g. 20">
            </div>
        </div>

        <div class="field">
            <label class="label">Width (ft)</label>
            <div class="control">
                <input class="input" type="number" name="width" step="0.1" min="1" value="{{if .Width}}{{printf "%.1f" .Width}}{{end}}" required placeholder="e.g. 16">
            </div>
        </div>

        <div class="field">
            <label class="label">Height above grade (ft)</label>
            <div class="control">
                <input class="input" type="number" name="height" step="0.1" min="0" value="{{if .Height}}{{printf "%.1f" .Height}}{{end}}" required placeholder="e.g. 3">
            </div>
        </div>

        <div class="field">
            <label class="label">
                Finish Level
                <a href="#" class="ml-2" onclick="document.getElementById('finish-modal').classList.add('is-active'); return false;">
                    <span class="icon"><i class="fas fa-question-circle has-text-info"></i></span>
                </a>
            </label>
            <div class="control">
                <div class="select is-fullwidth">
                    <select name="finish" required>
                        <option value="1" {{if eq .Material "outdoorWood"}}selected{{end}}>Economy — Pressure Treated $</option>
                        <option value="2" {{if eq .Material "cedar"}}selected{{end}}>Standard — Cedar $$</option>
                        <option value="3" {{if eq .Material "timberTechPrime"}}selected{{end}}>Enhanced — Composite $$$</option>
                        <option value="4" {{if eq .Material "timberTechProReserve"}}selected{{end}}>Premium — Composite Reserve $$$$</option>
                        <option value="5" {{if eq .Material "timberTechProLegacy"}}selected{{end}}>Premier — Composite Legacy $$$$$</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="field">
            <label class="checkbox">
                <input type="checkbox" name="hasStairs" {{if .StairWidth}}checked{{end}}>
                Include stairs
            </label>
        </div>

        <div class="field">
            <label class="checkbox">
                <input type="checkbox" name="hasDemo" {{if .HasDemo}}checked{{end}}>
                Demo and dispose of existing deck
            </label>
        </div>

                        <!-- Modal Help Dialog-->
                        <div id="finish-modal" class="modal">
                            <div class="modal-background" onclick="this.parentElement.classList.remove('is-active')"></div>
                            <div class="modal-card">
                                <header class="modal-card-head"><p class="modal-card-title">Finish Level Guide - You can customize this later</p></header>
                                <section class="modal-card-body">
                                    <table class="table is-fullwidth is-striped is-hoverable">
                                        <thead>
                                            <tr>
                                                <th>Finish Level</th>
                                                <th>Deck</th>
                                                <th>Rails</th>
                                                <th>Fascia</th>
                                                <th>Infill</th>
                                                <th>Joists</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td class="has-text-weight-bold">Economy</td>
                                                <td>Pressure-treated lumber</td>
                                                <td>Outdoor Wood</td>
                                                <td>Optional</td>
                                                <td>Outdoor Wood</td>
                                                <td>24" oc</td>
                                            </tr>
                                            <tr>
                                                <td class="has-text-weight-bold">Standard</td>
                                                <td>Western red cedar</td>
                                                <td>Cedar</td>
                                                <td>Optional</td>
                                                <td>Cedar</td>
                                                <td>24" oc</td>
                                            </tr>
                                            <tr>
                                                <td class="has-text-weight-bold">Enhanced</td>
                                                <td>TimberTech Prime+ composite</td>
                                                <td>Aluminum</td>
                                                <td>Optional</td>
                                                <td>Aluminum balusters</td>
                                                <td>16" oc</td>
                                            </tr>
                                            <tr>
                                                <td class="has-text-weight-bold">Premium</td>
                                                <td>TimberTech Pro Reserve</td>
                                                <td>Aluminum</td>
                                                <td>Included</td>
                                                <td>Stainless cable</td>
                                                <td>12" oc</td>
                                            </tr>
                                            <tr>
                                                <td class="has-text-weight-bold">Premier</td>
                                                <td>TimberTech Pro Legacy</td>
                                                <td>Composite</td>
                                                <td>Included</td>
                                                <td>Glass</td>
                                                <td>Metal frame</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    </section>
                                <footer class="modal-card-foot">
                                    <button class="button" type="button" onclick="document.getElementById('finish-modal').classList.remove('is-active')">Close</button>
                                </footer>
                            </div>
                        </div>
                    </div>
                </div>
        <div class="field mt-5">
            <div class="control">
                <input class="button is-primary is-fullwidth is-medium" type="submit" value="Get Estimate">
            </div>
        </div>

    </form>
    {{end}}
   {{template "footer.gohtml" .}}
{{end}}