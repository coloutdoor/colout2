{{define "patio.gohtml"}}
  {{template "header.gohtml" .Header}}
  {{template "deckheader.gohtml" .}}

  {{with .Page}}
    <form id="patio-form" method="post" action="/patio-estimate" class="box" style="max-width: 480px;">

        <div class="field">
            <label class="label">
                Patio Type
                <a href="#" class="ml-2" onclick="document.getElementById('patio-type-modal').classList.add('is-active'); return false;">
                    <span class="icon"><i class="fas fa-question-circle has-text-info"></i></span>
                </a>
            </label>
            <div class="control">
                <div class="select is-fullwidth">
                    <select name="patioType" required>
                        <option value="pergola">Pergola</option>
                        <option value="leanto">Lean-to</option>
                        <option value="truss">Truss</option>
                        <option value="timberframe">Timberframe</option>
                    </select>
                </div>
            </div>

        <div class="field">
            <label class="label">Project Description</label>
            <div class="control">
                <input class="input" type="text" name="desc" maxlength="50" placeholder="e.g. Back patio, over the deck...">
            </div>
        </div>

        <div class="field">
            <label class="label">Depth (ft) <span class="has-text-grey-light">(out from house)</span></label>
            <div class="control">
                <input class="input" type="number" name="length" step="0.1" min="1" required placeholder="e.g. 14">
            </div>
        </div>

        <div class="field">
            <label class="label">Width (ft) <span class="has-text-grey-light">(along house)</span></label>
            <div class="control">
                <input class="input" type="number" name="width" step="0.1" min="1" required placeholder="e.g. 20">
            </div>
        </div>

        <div class="field">
            <label class="label">Height (ft) <span class="has-text-grey-light">(at the gutters)</span></label>
            <div class="control">
                <input class="input" type="number" name="height" step="0.1" min="0" required placeholder="e.g. 9">
            </div>
        </div>

        </div>

        <!-- Modal Help Dialog-->
        <div id="patio-type-modal" class="modal">
            <div class="modal-background" onclick="this.parentElement.classList.remove('is-active')"></div>
            <div class="modal-card">
                <header class="modal-card-head"><p class="modal-card-title">Patio Type Guide - You can customize this later</p></header>
                <section class="modal-card-body">
                    <table class="table is-fullwidth is-striped is-hoverable">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Roof Style</th>
                                <th>Attachment</th>
                                <th>Best For</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="has-text-weight-bold">Pergola</td>
                                <td>Open lattice/slat roof</td>
                                <td>Attached or freestanding</td>
                                <td>Partial shade, decorative</td>
                            </tr>
                            <tr>
                                <td class="has-text-weight-bold">Lean-to</td>
                                <td>Single-slope, solid roof</td>
                                <td>Attached only</td>
                                <td>Budget-friendly full coverage</td>
                            </tr>
                            <tr>
                                <td class="has-text-weight-bold">Truss</td>
                                <td>Peaked/gable, solid roof</td>
                                <td>Attached or freestanding</td>
                                <td>Full coverage matching the house</td>
                            </tr>
                            <tr>
                                <td class="has-text-weight-bold">Timberframe</td>
                                <td>Exposed post-and-beam, solid roof</td>
                                <td>Attached or freestanding</td>
                                <td>Premium, architectural look</td>
                            </tr>
                        </tbody>
                    </table>
                </section>
                <footer class="modal-card-foot">
                    <button class="button" type="button" onclick="document.getElementById('patio-type-modal').classList.remove('is-active')">Close</button>
                </footer>
            </div>
        </div>

        <div class="field">
            <label class="label">Project Type</label>
            <div class="control">
                <div class="select is-fullwidth">
                    <select name="diyMode" id="diy-mode" onchange="setMode(+this.value)">
                        <option value="0" {{if eq .DIYMode 0}}selected{{end}}>Full Service</option>
                        <option value="1" {{if eq .DIYMode 1}}selected{{end}}>Plans + Materials</option>
                        <option value="2" {{if eq .DIYMode 2}}selected{{end}}>Plans Only</option>
                    </select>
                </div>
            </div>
            <p id="mode-help" class="help">
              {{if eq .DIYMode 1}}Design, engineering, permits, and materials list — you install.
              {{- else if eq .DIYMode 2}}Professional design, engineering, and permit package only — no materials.
              {{- else}}Columbia Outdoor builds your project from estimate to final walkthrough.{{end}}
            </p>
        </div>

        <div class="field mt-5">
            <div class="control">
                <input id="submit-btn" class="button is-primary is-fullwidth is-medium" type="submit"
                  value="{{if eq .DIYMode 1}}Get Plans + Materials Estimate{{else if eq .DIYMode 2}}Get Plans Only Estimate{{else}}Get Estimate{{end}}">
            </div>
        </div>

    </form>

    <form method="post" action="/calc/reset" class="has-text-centered mt-2" style="max-width:480px;"
      onsubmit="return confirm('Clear all values and start over?');">
      <input type="hidden" name="return" value="/patio-cover-calculator">
      <button type="submit" class="button is-small is-text has-text-grey">Start over</button>
    </form>

    <div style="max-width:480px; margin-top:2rem;">
      <h2 class="title is-4">How It Works</h2>
      <div class="columns is-mobile mt-2">
        <div class="column has-text-centered">
          <span class="icon is-large has-text-link"><i class="fas fa-ruler-combined fa-2x"></i></span>
          <p class="has-text-weight-bold mt-2">1. Enter Dimensions</p>
          <p class="has-text-grey is-size-7">Depth, width, height, and cover type. Takes about 60 seconds.</p>
        </div>
        <div class="column has-text-centered">
          <span class="icon is-large has-text-link"><i class="fas fa-dollar-sign fa-2x"></i></span>
          <p class="has-text-weight-bold mt-2">2. Get Instant Estimate</p>
          <p class="has-text-grey is-size-7">See a full itemized cost breakdown — structure, roof, and demo.</p>
        </div>
        <div class="column has-text-centered">
          <span class="icon is-large has-text-link"><i class="fas fa-share-alt fa-2x"></i></span>
          <p class="has-text-weight-bold mt-2">3. Save or Share</p>
          <p class="has-text-grey is-size-7">Save your estimate, email it to yourself, or share it with a contractor.</p>
        </div>
      </div>
    </div>

    <script>
    const modeHelp = [
      'Columbia Outdoor builds your project from estimate to final walkthrough.',
      'Design, engineering, permits, and materials list — you install.',
      'Professional design, engineering, and permit package only — no materials.'
    ];
    const modeSubmit = ['Get Estimate', 'Get Plans + Materials Estimate', 'Get Plans Only Estimate'];

    function setMode(mode) {
      document.getElementById('mode-help').textContent = modeHelp[mode];
      document.getElementById('submit-btn').value = modeSubmit[mode];
    }
    </script>
    {{end}}
   {{template "footer.gohtml" .}}
{{end}}
