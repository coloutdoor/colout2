{{define "homeowner.gohtml"}}
  {{template "header.gohtml" .Header}}

  <!-- Hero -->
  <section class="section" style="background: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url('https://storage.googleapis.com/columbiaoutdoor-images/deck2.jpg') center/cover no-repeat; padding: 5rem 1.5rem;">
    <div class="container has-text-centered">
      <h1 class="title is-1 has-text-white">SW Washington Deck Builder — Instant Estimates</h1>
      <p class="subtitle has-text-white mt-4" style="max-width:700px; margin:1.5rem auto;">
        Stop chasing bids. Start building. Columbia Outdoor delivers <strong class="has-text-warning">transparent pricing, quality craftsmanship, and expert project management</strong> — so your project is done right the first time.
      </p>
      <div class="buttons is-centered mt-5">
        <a href="/contact" class="button is-light is-large is-rounded">
          Talk to a Professional
        </a>
        <a href="/deck-calculator?option=deck" class="button is-large is-rounded" style="background-color:#6b7280; border-color:#6b7280; color:white;">
          <strong>Build Your Own Deck Estimate</strong>
        </a>
      </div>
      <p class="has-text-white-ter mt-3 is-size-7">Serving Clark and Cowlitz County, SW Washington.</p>
    </div>
  </section>

  <!-- Two Paths -->
  <section class="section has-background-white">
    <div class="container">
      <h2 class="title is-3 has-text-centered has-text-dark mb-6">Quick Deck Estimates with DIY Options</h2>
      <div class="columns is-variable is-6" style="margin-top:0">

        <div class="column">
          <div class="box has-text-centered" style="height:100%; border-top: 4px solid #3273dc; display:flex; flex-direction:column;">
            <span class="icon is-large has-text-link mb-3"><i class="fas fa-hard-hat fa-2x"></i></span>
            <h4 class="title is-4">Free Professional Consultation</h4>
            <p class="has-text-grey mb-4">
              Columbia Outdoor's experienced team handles your project from estimate to final walkthrough.
              One point of contact, transparent pricing, and craftsmen who take pride in their work.
            </p>
            <ul class="has-text-left mb-5" style="list-style:none; padding:0; flex-grow:1;">
              <li class="mb-2"><span class="icon has-text-success"><i class="fas fa-check"></i></span> Licensed, insured, and locally experienced in SW Washington</li>
              <li class="mb-2"><span class="icon has-text-success"><i class="fas fa-check"></i></span> Dedicated project manager as your single point of contact</li>
              <li class="mb-2"><span class="icon has-text-success"><i class="fas fa-check"></i></span> Locked-in pricing with no surprise change orders</li>
              <li class="mb-2"><span class="icon has-text-success"><i class="fas fa-check"></i></span> Permits and inspections handled for you</li>
            </ul>
            <a href="/contact" class="button is-link is-rounded is-fullwidth">Talk to Us</a>
          </div>
        </div>

        <div class="column">
          <div class="box has-text-centered" style="height:100%; border-top: 4px solid #f4c430; display:flex; flex-direction:column;">
            <span class="icon is-large has-text-warning mb-3"><i class="fas fa-calculator fa-2x"></i></span>
            <h4 class="title is-4">Build Your Own Deck Estimate</h4>
            <p class="has-text-grey mb-4">
              Use our free interactive calculator to price your deck project instantly.
              Choose your materials, dimensions, and options — and see the price update in real time.
              Perfect for planning, budgeting, and comparing estimates, without talking to anyone.
            </p>
            <ul class="has-text-left mb-5" style="list-style:none; padding:0; flex-grow:1;">
              <li class="mb-2"><span class="icon has-text-success"><i class="fas fa-check"></i></span> Instant pricing — no waiting, no callbacks</li>
              <li class="mb-2"><span class="icon has-text-success"><i class="fas fa-check"></i></span> Choose deck size, materials, rails, stairs, and more</li>
              <li class="mb-2"><span class="icon has-text-success"><i class="fas fa-check"></i></span> Save and share your estimate</li>
              <li class="mb-2"><span class="icon has-text-success"><i class="fas fa-check"></i></span> No account required to get started</li>
              <li class="mb-2"><span class="icon has-text-success"><i class="fas fa-check"></i></span> Zero sales pressure to compare options</li>
            </ul>
            <a href="/deck-calculator?option=deck" class="button is-rounded is-fullwidth" style="background-color:#6b7280; border-color:#6b7280; color:white;">
              <strong>Start the Deck Calculator</strong>
            </a>
          </div>
        </div>

        <div class="column">
          <div class="box has-text-centered" style="height:100%; border-top: 4px solid #48c78e; display:flex; flex-direction:column;">
            <span class="icon is-large has-text-success mb-3"><i class="fas fa-tools fa-2x"></i></span>
            <h4 class="title is-4">DIY Deck Package</h4>
            <p class="has-text-grey mb-4">
              Build your deck yourself with professional-grade plans and a complete materials package.
              Get everything you need to pull permits, order materials, and build decks right the first time.
            </p>
            <ul class="has-text-left mb-5" style="list-style:none; padding:0; flex-grow:1;">
              <li class="mb-2"><span class="icon has-text-success"><i class="fas fa-check"></i></span> Professional design drawings</li>
              <li class="mb-2"><span class="icon has-text-success"><i class="fas fa-check"></i></span> Structural engineering</li>
              <li class="mb-2"><span class="icon has-text-success"><i class="fas fa-check"></i></span> Permit application package</li>
              <li class="mb-2"><span class="icon has-text-success"><i class="fas fa-check"></i></span> Complete materials list</li>
              <li class="mb-2"><span class="icon has-text-success"><i class="fas fa-check"></i></span> On site consultation</li>
              <li class="mb-2"><span class="icon has-text-success"><i class="fas fa-check"></i></span> Optional full materials delivery</li>
            </ul>
            <a href="/deck-calculator?option=deck&amp;diyMode=1" class="button is-success is-rounded is-fullwidth">
              <strong>Get DIY Deck Package Estimate</strong>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Why Columbia Outdoor -->
  <section class="section has-background-light">
    <div class="container" style="max-width:900px;">
      <h2 class="title is-3 has-text-centered has-text-dark mb-6">Deck Build Process</h2>
      <div class="columns is-multiline" style="margin-top:0">

        <div class="column is-half">
          <div style="display:flex; align-items:flex-start; gap:1rem;">
            <span class="icon has-text-success mt-1"><i class="fas fa-award fa-lg"></i></span>
            <div>
              <p class="has-text-weight-bold is-size-5">Built to Last</p>
              <p class="has-text-grey">We use premium materials, proper fasteners, and code-compliant framing on every project — built to pass inspection and stand up to SW Washington winters.</p>
            </div>
          </div>
        </div>

        <div class="column is-half">
          <div style="display:flex; align-items:flex-start; gap:1rem;">
            <span class="icon has-text-success mt-1"><i class="fas fa-dollar-sign fa-lg"></i></span>
            <div>
              <p class="has-text-weight-bold is-size-5">Transparent, Locked-In Pricing</p>
              <p class="has-text-grey">No vague quotes. Our itemized estimates lock in costs upfront. Change orders require explicit approval — no surprises.</p>
            </div>
          </div>
        </div>

        <div class="column is-half">
          <div style="display:flex; align-items:flex-start; gap:1rem;">
            <span class="icon has-text-success mt-1"><i class="fas fa-user-tie fa-lg"></i></span>
            <div>
              <p class="has-text-weight-bold is-size-5">Dedicated Project Manager</p>
              <p class="has-text-grey">One person handles site visits, permits, contractor coordination, and progress updates. You stay informed without managing the details.</p>
            </div>
          </div>
        </div>

        <div class="column is-half">
          <div style="display:flex; align-items:flex-start; gap:1rem;">
            <span class="icon has-text-success mt-1"><i class="fas fa-map-marker-alt fa-lg"></i></span>
            <div>
              <p class="has-text-weight-bold is-size-5">Built for SW Washington</p>
              <p class="has-text-grey">SW Washington regulations, permit requirements, and climate demands are our specialty. We know Clark and Cowlitz County — and what it takes to build decks right the first time.</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Photo Grid -->
  <section class="section has-background-white">
    <div class="container">
      <h2 class="title is-3 has-text-centered has-text-dark mb-2">Recent Deck Projects in Woodland, Ridgefield, Kalama, and La Center</h2>
      <p class="has-text-centered has-text-grey mb-5">Decks, covers, and outdoor spaces built across SW Washington.</p>
      {{if .Page}}
      <div style="position:relative; max-width:900px; margin:0 auto;">
        <div id="co-carousel" style="overflow:hidden; border-radius:8px; aspect-ratio:4/3;">
          <div id="co-slides" style="display:flex; transition:transform 0.5s ease; height:100%;">
            {{range .Page}}
            <img src="{{.URI}}" alt="{{.Description}} — {{.City}}, WA" style="min-width:100%; object-fit:cover;">
            {{end}}
          </div>
        </div>
        <button onclick="coSlide(-1)" aria-label="Previous" style="position:absolute; top:50%; left:-1.25rem; transform:translateY(-50%); background:rgba(0,0,0,0.45); border:none; color:white; border-radius:50%; width:2.5rem; height:2.5rem; font-size:1.2rem; cursor:pointer; display:flex; align-items:center; justify-content:center;">&#8249;</button>
        <button onclick="coSlide(1)"  aria-label="Next"     style="position:absolute; top:50%; right:-1.25rem; transform:translateY(-50%); background:rgba(0,0,0,0.45); border:none; color:white; border-radius:50%; width:2.5rem; height:2.5rem; font-size:1.2rem; cursor:pointer; display:flex; align-items:center; justify-content:center;">&#8250;</button>
        <div id="co-dots" style="display:flex; justify-content:center; gap:0.4rem; margin-top:0.75rem;">
          {{range $i, $p := .Page}}
          <span class="co-dot" onclick="coGoTo({{$i}})" style="width:10px;height:10px;border-radius:50%;background:{{if eq $i 0}}#3273dc{{else}}#ccc{{end}};cursor:pointer;display:inline-block;"></span>
          {{end}}
        </div>
      </div>
      <script>
      (function() {
        var current = 0;
        var total = {{len .Page}};
        var autoTimer = setInterval(function(){ coSlide(1); }, 5000);

        window.coSlide = function(dir) {
          coGoTo((current + dir + total) % total);
          resetTimer();
        };
        window.coGoTo = function(idx) {
          current = idx;
          document.getElementById('co-slides').style.transform = 'translateX(-' + (current * 100) + '%)';
          document.querySelectorAll('.co-dot').forEach(function(d, i) {
            d.style.background = i === current ? '#3273dc' : '#ccc';
          });
        };
        function resetTimer() {
          clearInterval(autoTimer);
          autoTimer = setInterval(function(){ coSlide(1); }, 5000);
        }
      })();
      </script>
      {{end}}
      <div class="has-text-centered mt-5">
        <p class="has-text-grey mb-4">Follow us and leave a review</p>
        <div class="buttons is-centered">
          <a href="https://www.facebook.com/columbiaoutdoor/" target="_blank" rel="noopener" class="button is-medium" style="background-color:#1877f2; border-color:#1877f2; color:white;">
            <span class="icon"><i class="fab fa-facebook-f"></i></span>
            <span>Facebook</span>
          </a>
          <a href="https://www.instagram.com/outdoorcolumbia/" target="_blank" rel="noopener" class="button is-medium" style="background-color:#e1306c; border-color:#e1306c; color:white;">
            <span class="icon"><i class="fab fa-instagram"></i></span>
            <span>Instagram</span>
          </a>
          <a href="https://x.com/OutdoorColumbia" target="_blank" rel="noopener" class="button is-medium" style="background-color:#000; border-color:#000; color:white;">
            <span class="icon"><i class="fab fa-x-twitter"></i></span>
            <span>X</span>
          </a>
          <a href="https://www.google.com/search?q=columbia+outdoor+woodland" target="_blank" rel="noopener" class="button is-medium" style="background-color:#4285f4; border-color:#4285f4; color:white;">
            <span class="icon"><i class="fab fa-google"></i></span>
            <span>Google Reviews</span>
          </a>
        </div>
      </div>
    </div>
  </section>


  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "HomeAndConstructionBusiness",
    "name": "Columbia Outdoor",
    "url": "https://columbiaoutdoor.com",
    "telephone": "+13607878062",
    "email": "info@columbiaoutdoor.com",
    "description": "Custom deck builder serving SW Washington. Transparent pricing, professional design, and DIY packages for Woodland, Ridgefield, Kalama, and La Center.",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Woodland",
      "addressRegion": "WA",
      "addressCountry": "US"
    },
    "areaServed": [
      {"@type": "City", "name": "Woodland, WA"},
      {"@type": "City", "name": "Ridgefield, WA"},
      {"@type": "City", "name": "Kalama, WA"},
      {"@type": "City", "name": "La Center, WA"}
    ],
    "sameAs": [
      "https://www.facebook.com/columbiaoutdoor/",
      "https://www.instagram.com/outdoorcolumbia/",
      "https://x.com/OutdoorColumbia"
    ]
  }
  </script>

  {{template "footer.gohtml" .}}
{{end}}
