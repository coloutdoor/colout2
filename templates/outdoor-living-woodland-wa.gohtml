{{define "outdoor-living-woodland-wa.gohtml"}}
  {{template "header.gohtml" .Header}}

  <!-- Hero -->
  <section class="section" style="background: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url('https://storage.googleapis.com/columbiaoutdoor-images/photos-0378.jpg') center/cover no-repeat; padding: 5rem 1.5rem;">
    <div class="container has-text-centered">
      <h1 class="title is-1 has-text-white">Outdoor Living Contractors in Woodland, WA</h1>
      <p class="subtitle has-text-white mt-4" style="max-width:700px; margin:1.5rem auto;">
        Stop chasing bids. Start building. Columbia Outdoor delivers
        <strong class="has-text-warning">transparent pricing, quality craftsmanship, and expert project management</strong>
        for decks, covers, and full outdoor living spaces across Woodland and the surrounding Pacific Northwest.
      </p>
      <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;">
        <a href="/contact" class="button is-warning is-large is-rounded mt-4"><strong>Get a Free Estimate</strong></a>
        <a href="/deck-calculator?option=deck" class="button is-light is-large is-rounded mt-4">Try the Deck Calculator</a>
      </div>
      <p class="has-text-white-ter mt-3 is-size-7">
        Serving Woodland, Kalama, Castle Rock, Ridgefield, La Center, and all of Clark and Cowlitz County, SW Washington.
      </p>
    </div>
  </section>

  <!-- What We Build -->
  <section class="section has-background-light">
    <div class="container">
      <h2 class="title is-3 has-text-centered has-text-dark mb-6">Outdoor Living Spaces We Build</h2>
      <div class="columns">
        <div class="column">
          <div class="box" style="height:100%;">
            <p class="title is-5">Decks &amp; Patio Covers</p>
            <p class="has-text-grey mb-3">
              Composite, cedar, and timberframe decks and covers — the foundation of every
              outdoor living space, engineered for SW Washington weather.
            </p>
            <ul>
              <li>Composite, cedar, and timberframe construction</li>
              <li>Integrated lighting and ceiling fans</li>
              <li>Engineered for local snow and wind loads</li>
            </ul>
          </div>
        </div>
        <div class="column">
          <div class="box" style="height:100%;">
            <p class="title is-5">Outdoor Kitchens &amp; Bars</p>
            <p class="has-text-grey mb-3">
              Built-in bars, sinks, and kitchen space under a cedar-finished cover — designed
              for entertaining year-round.
            </p>
            <ul>
              <li>Built-in bar and countertop space</li>
              <li>Plumbing and gas rough-in coordination</li>
              <li>Cedar tongue-and-groove ceiling finishes</li>
            </ul>
          </div>
        </div>
        <div class="column">
          <div class="box" style="height:100%;">
            <p class="title is-5">Fire Features &amp; Finishing Touches</p>
            <p class="has-text-grey mb-3">
              Fireplaces, skylights, hogwire and cable rail infill, and lighting that turn a deck
              or cover into a true outdoor room.
            </p>
            <ul>
              <li>Fireplaces and integrated lighting</li>
              <li>Skylights for natural daylight under a cover</li>
              <li>Custom rail infill: cable, glass, or hogwire</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section">
    <div class="container" style="max-width:780px;">
      <h2 class="title is-3 has-text-centered mb-2">Why Woodland Homeowners Choose Columbia Outdoor</h2>
      <p class="has-text-centered has-text-grey mb-5">
        Columbia Outdoor's experienced team handles your outdoor living project from estimate to
        final walkthrough. One point of contact, transparent pricing, and craftsmen who take pride
        in their work.
      </p>
      <div style="display:flex; flex-direction:column; gap:1rem;">
        <div style="display:flex; align-items:flex-start; gap:1rem;">
          <span class="icon has-text-success mt-1"><i class="fas fa-check-circle fa-lg"></i></span>
          <p class="is-size-5">Licensed, insured, and locally experienced in SW Washington</p>
        </div>
        <div style="display:flex; align-items:flex-start; gap:1rem;">
          <span class="icon has-text-success mt-1"><i class="fas fa-check-circle fa-lg"></i></span>
          <p class="is-size-5">Dedicated project manager as your single point of contact</p>
        </div>
        <div style="display:flex; align-items:flex-start; gap:1rem;">
          <span class="icon has-text-success mt-1"><i class="fas fa-check-circle fa-lg"></i></span>
          <p class="is-size-5">Locked-in pricing with no surprise change orders</p>
        </div>
        <div style="display:flex; align-items:flex-start; gap:1rem;">
          <span class="icon has-text-success mt-1"><i class="fas fa-check-circle fa-lg"></i></span>
          <p class="is-size-5">Permits and inspections handled for you</p>
        </div>
      </div>
      <div class="has-text-centered mt-5">
        <a href="/contact" class="button is-warning is-rounded"><strong>Talk to Us</strong></a>
      </div>
    </div>
  </section>

  <!-- Built for SW Washington -->
  <section class="section has-background-warning-light">
    <div class="container has-text-centered" style="max-width:700px;">
      <h2 class="title is-3">Built for SW Washington</h2>
      <p class="is-size-5">
        SW Washington regulations, permit requirements, and climate demands are our specialty.
        We know Cowlitz County — and what it takes to build an outdoor living space right the first time.
      </p>
      <p class="mt-3">
        No vague quotes. Our itemized estimates lock in costs upfront. Change orders require
        explicit approval — no surprises.
      </p>
    </div>
  </section>

  <!-- Recent Projects -->
  <section class="section">
    <div class="container">
      <h2 class="title is-3 has-text-centered mb-5">Recent Outdoor Living Projects</h2>
      <div class="oliv-photo-grid">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0378.jpg" loading="lazy" alt="Large deck and cover with fireplace and lights — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0262.jpg" loading="lazy" alt="Outdoor room with bar and cedar finish — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0298.jpg" loading="lazy" alt="Cedar tongue and groove finish with ceiling fan — Vancouver, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0373.jpg" loading="lazy" alt="Large timberframe cover with deck and skylights — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0556.jpg" loading="lazy" alt="Cover painted and finished with wrapped posts and gutters — Vancouver, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0303.jpg" loading="lazy" alt="Patio cover with lights and skylights — Camas, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0260.jpg" loading="lazy" alt="Cover with bar for outdoor living — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0560.jpg" loading="lazy" alt="Cover with lights and fan — Vancouver, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0474.jpg" loading="lazy" alt="Large deck and stairs with hogwire rail infill — Brush Prairie, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0465.jpg" loading="lazy" alt="Deck with gazebo and hot tub — Washougal, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0491.jpg" loading="lazy" alt="Upper deck with cover and stairs — Brush Prairie, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0082.jpeg" loading="lazy" alt="Enclosed outdoor cover — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0336.jpg" loading="lazy" alt="Cover and deck restoration — Woodland, WA">
        <img src="https://storage.googleapis.com/columbiaoutdoor-images/photos-0492.jpeg" loading="lazy" alt="Outdoor kitchen sink — Woodland, WA">
      </div>
    </div>
  </section>

  <style>
  .oliv-photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }
  .oliv-photo-grid img {
    width: 100%;
    aspect-ratio: 4/3;
    object-fit: cover;
    border-radius: 6px;
    display: block;
  }
  </style>

  <!-- Final CTA -->
  <section class="section" style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://storage.googleapis.com/columbiaoutdoor-images/photos-0262.jpg') center/cover no-repeat; padding: 4rem 1.5rem;">
    <div class="container has-text-centered">
      <h2 class="title is-2 has-text-white">Ready to Build Your Outdoor Living Space?</h2>
      <p class="subtitle has-text-white mt-3">
        Get an itemized estimate with no obligation. Our project manager will walk you through
        style options, materials, and timeline for your Woodland outdoor living project.
      </p>
      <div style="display:flex; gap:0.75rem; justify-content:center; flex-wrap:wrap;">
        <a href="/contact" class="button is-warning is-large is-rounded mt-4"><strong>Talk to a Professional</strong></a>
        <a href="/deck-calculator?option=deck" class="button is-light is-large is-rounded mt-4">Build Your Own Deck Estimate</a>
      </div>
    </div>
  </section>

  {{template "footer.gohtml" .}}
{{end}}
